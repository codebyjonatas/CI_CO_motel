# CI/CO Motel — Variáveis de ambiente
#
# Este arquivo é um MODELO versionado. Ele NÃO contém segredos.
# O arquivo real (.env.local) é gerado por `bin/setup-env` a partir do Bitwarden
# e está no .gitignore.
#
# Uso sem direnv:
#   set -a; source .env.local; set +a
# Uso com direnv (recomendado):
#   direnv allow

# === Obrigatórias em qualquer ambiente ===
# Chave que descriptografa config/credentials.yml.enc (32 chars hex)
RAILS_MASTER_KEY=

# === Produção ===
# Host público da aplicação (usado em config.hosts / force_ssl)
APP_HOST=

# Senha do usuário PostgreSQL de produção (config/database.yml)
SYS_CHECK_IN_CHECK_OUT_DATABASE_PASSWORD=

# Senhas usadas por `rails db:seed` quando RAILS_ENV=production
# (o seed aborta se estiverem vazias)
SEED_ADMIN_PASSWORD=
SEED_ATTENDANT_PASSWORD=

# === Configurações de negócio (opcionais; sobrescrevem credentials) ===
# Limites de desconto (% e R$)
DISCOUNT_LIMITS_ADMIN_MAX_PERCENT=
DISCOUNT_LIMITS_ADMIN_MAX_ABSOLUTE=
DISCOUNT_LIMITS_ATTENDANT_MAX_PERCENT=
DISCOUNT_LIMITS_ATTENDANT_MAX_ABSOLUTE=

# Minutos de quarentena após limpeza do quarto
ROOM_CLEANING_QUARANTINE_MINUTES=

# === SMTP (opcional) ===
SMTP_ADDRESS=
SMTP_PORT=
SMTP_USER_NAME=
SMTP_PASSWORD=
