<div class="min-vh-100 d-flex align-items-center justify-content-center bg-bg py-5 px-3">
  <div class="w-100" style="max-width: 480px;">
    <!-- Logo/Brand -->
    <div class="text-center mb-5">
      <a href="<%= root_path %>" class="navbar-brand-custom d-inline-flex align-items-center justify-content-center gap-2 text-decoration-none">
        <span class="logo-mark"><i class="bi bi-building"></i></span>
        <span class="fw-bold" style="font-size: 1.5rem;">Sys Motel</span>
      </a>
      <p class="text-muted mt-3 mb-0">Sistema de Check-in/Check-out</p>
    </div>

    <!-- Card de Cadastro -->
    <div class="card card-feature">
      <div class="p-4 p-md-5">
        <header class="text-center mb-4">
          <span class="badge-custom badge-accent mb-2"><i class="bi bi-person-plus-fill me-1"></i>Novo Cadastro</span>
          <h1 class="h3 mb-1">Criar conta</h1>
          <p class="text-muted small mb-0">Preencha seus dados para começar</p>
        </header>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="mb-3">
            <%= f.label :name, "Nome completo", class: "form-label" %>
            <%= f.text_field :name,
                        class: "form-control",
                        autofocus: true,
                        autocomplete: "name",
                        placeholder: "Seu nome completo",
                        required: true %>
            <div class="form-text">Como você será identificado no sistema</div>
          </div>

          <div class="mb-3">
            <%= f.label :email, "E-mail", class: "form-label" %>
            <%= f.email_field :email,
                        class: "form-control",
                        autocomplete: "email",
                        placeholder: "seu@email.com",
                        required: true %>
          </div>

          <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <%= f.label :password, "Senha", class: "form-label mb-0" %>
              <% if @minimum_password_length %>
                <span class="text-muted small">(mín. <%= @minimum_password_length %> caracteres)</span>
              <% end %>
            </div>
            <%= f.password_field :password,
                         class: "form-control",
                         autocomplete: "new-password",
                         placeholder: "••••••••",
                         required: true %>
            <div class="form-text">Use uma senha forte com letras, números e símbolos</div>
          </div>

          <div class="mb-4">
            <%= f.label :password_confirmation, "Confirmar senha", class: "form-label" %>
            <%= f.password_field :password_confirmation,
                         class: "form-control",
                         autocomplete: "new-password",
                         placeholder: "••••••••",
                         required: true %>
          </div>

          <div class="d-grid mb-4">
            <%= f.submit "Criar conta", class: "btn btn-primary btn-lg" %>
          </div>
        <% end %>

        <div class="text-center">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>

    <!-- Footer info -->
    <div class="text-center mt-4 text-muted small">
      <p class="mb-1">&copy; <%= Time.current.year %> CI/CO Motel. Todos os direitos reservados.</p>
    </div>
  </div>
</div>