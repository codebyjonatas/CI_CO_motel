<div class="min-vh-100 d-flex align-items-center justify-content-center bg-bg py-5 px-3">
  <div class="w-100" style="max-width: 420px;">
    <!-- Logo/Brand -->
    <div class="text-center mb-5">
      <a href="<%= root_path %>" class="navbar-brand-custom d-inline-flex align-items-center justify-content-center gap-2 text-decoration-none">
        <span class="logo-mark"><i class="bi bi-building"></i></span>
        <span class="fw-bold" style="font-size: 1.5rem;">Sys Motel</span>
      </a>
      <p class="text-muted mt-3 mb-0">Sistema de Check-in/Check-out</p>
    </div>

    <!-- Card de Login -->
    <div class="card card-feature">
      <div class="p-4 p-md-5">
        <header class="text-center mb-4">
          <h1 class="h3 mb-1">Entrar no sistema</h1>
          <p class="text-muted small mb-0">Use suas credenciais de atendente ou administrador</p>
        </header>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="mb-3">
            <%= f.label :email, "E-mail", class: "form-label" %>
            <%= f.email_field :email,
                        class: "form-control",
                        autofocus: true,
                        autocomplete: "email",
                        placeholder: "seu@email.com",
                        required: true %>
          </div>

          <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <%= f.label :password, "Senha", class: "form-label mb-0" %>
            </div>
            <%= f.password_field :password,
                         class: "form-control",
                         autocomplete: "current-password",
                         placeholder: "••••••••",
                         required: true %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="mb-4">
              <div class="form-check">
                <%= f.check_box :remember_me, class: "form-check-input", id: "remember_me" %>
                <%= f.label :remember_me, "Lembrar-me", class: "form-check-label small", for: "remember_me" %>
              </div>
            </div>
          <% end %>

          <div class="d-grid mb-4">
            <%= f.submit "Entrar", class: "btn btn-primary btn-lg" %>
          </div>
        <% end %>

        <div class="text-center">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>

    <!-- Footer info -->
    <div class="text-center mt-4 text-muted small">
      <p class="mb-1">&copy; <%= Time.current.year %> CI/CO Motel. Todos os direitos reservados.</p>
      <p class="mb-0">Versão <%= Rails.application.class.module_parent_name.underscore.dasherize rescue "1.0" %></p>
    </div>
  </div>
</div>