<% if resource.errors.any? %>
  <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" data-turbo-temporary>
    <div class="d-flex align-items-start gap-3">
      <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 1.25rem; margin-top: 0.125rem;"></i>
      <div class="flex-grow-1">
        <h6 class="mb-2">
          <%= pluralize resource.errors.count, "erro" %> impediram o processamento:
        </h6>
        <ul class="mb-0 small">
          <% resource.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
  </div>
<% end %>