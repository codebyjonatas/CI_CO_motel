<div class="d-flex flex-column flex-sm-row justify-content-center gap-2 flex-wrap text-center text-sm-start mt-4 pt-3 border-top" style="border-color: var(--color-border) !important;">
  <%- if controller_name != 'sessions' %>
    <%= link_to new_session_path(resource_name), class: "btn btn-primary btn-sm d-inline-flex align-items-center gap-1" do %>
      <i class="bi bi-box-arrow-in-right"></i>
      <span>Entrar</span>
    <% end %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to new_registration_path(resource_name), class: "btn btn-secondary btn-sm d-inline-flex align-items-center gap-1" do %>
      <i class="bi bi-person-plus"></i>
      <span>Cadastrar</span>
    <% end %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to new_password_path(resource_name), class: "btn btn-tertiary btn-sm d-inline-flex align-items-center gap-1" do %>
      <i class="bi bi-key"></i>
      <span>Esqueci a senha</span>
    <% end %>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <%= link_to new_confirmation_path(resource_name), class: "btn btn-tertiary btn-sm d-inline-flex align-items-center gap-1" do %>
      <i class="bi bi-envelope"></i>
      <span>Reenviar confirmação</span>
    <% end %>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <%= link_to new_unlock_path(resource_name), class: "btn btn-tertiary btn-sm d-inline-flex align-items-center gap-1" do %>
      <i class="bi bi-unlock"></i>
      <span>Reenviar desbloqueio</span>
    <% end %>
  <% end %>
</div>