<div class="min-vh-100 d-flex align-items-center justify-content-center bg-bg py-5 px-3">
  <div class="w-100" style="max-width: 420px;">
    <!-- Logo/Brand -->
    <div class="text-center mb-5">
      <a href="<%= root_path %>" class="navbar-brand-custom d-inline-flex align-items-center justify-content-center gap-2 text-decoration-none">
        <span class="logo-mark"><i class="bi bi-building"></i></span>
        <span class="fw-bold" style="font-size: 1.5rem;">Sys Motel</span>
      </a>
      <p class="text-muted mt-3 mb-0">Sistema de Check-in/Check-out</p>
    </div>

    <!-- Card de Desbloqueio -->
    <div class="card card-feature">
      <div class="p-4 p-md-5">
        <header class="text-center mb-4">
          <div class="icon-wrapper mx-auto mb-3" style="background-color: var(--color-warning-light); color: var(--color-warning);">
            <i class="bi bi-unlock-fill"></i>
          </div>
          <h1 class="h3 mb-1">Desbloquear conta</h1>
          <p class="text-muted small mb-0">Digite seu e-mail para receber instruções de desbloqueio</p>
        </header>

        <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "auth-form" }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="mb-4">
            <%= f.label :email, "E-mail cadastrado", class: "form-label" %>
            <%= f.email_field :email,
                        class: "form-control",
                        autofocus: true,
                        autocomplete: "email",
                        placeholder: "seu@email.com",
                        required: true %>
          </div>

          <div class="d-grid mb-4">
            <%= f.submit "Enviar instruções", class: "btn btn-primary btn-lg" %>
          </div>
        <% end %>

        <div class="text-center">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>

    <!-- Footer info -->
    <div class="text-center mt-4 text-muted small">
      <p class="mb-1">&copy; <%= Time.current.year %> CI/CO Motel. Todos os direitos reservados.</p>
    </div>
  </div>
</div>