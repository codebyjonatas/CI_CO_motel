<%= form_with model: room, class: "room-form" do |f| %>
  <% if room.errors.any? %>
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
      <h6 class="mb-2"><%= pluralize room.errors.count, "erro" %> ao salvar:</h6>
      <ul class="mb-0">
        <% room.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <div class="row g-4">
    <div class="col-md-6">
      <div class="card card-feature h-100">
        <div class="icon-wrapper mb-3" style="background-color: var(--color-primary-light); color: var(--color-primary);">
          <i class="bi bi-hash"></i>
        </div>
        <h4 class="mb-3">Identificação</h4>
        <div class="mb-3">
          <%= f.label :number, "Número do Quarto", class: "form-label" %>
          <%= f.text_field :number, class: "form-control", required: true, placeholder: "Ex: 101, 202-A" %>
          <div class="form-text">Identificador único do quarto (ex: 101, 202-A)</div>
        </div>
        <div class="mb-3">
          <%= f.label :floor, "Andar", class: "form-label" %>
          <%= f.number_field :floor, class: "form-control", min: 1, placeholder: "1" %>
          <div class="form-text">Número do andar onde o quarto está localizado</div>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card card-feature h-100">
        <div class="icon-wrapper mb-3" style="background-color: var(--color-accent-light); color: var(--color-accent);">
          <i class="bi bi-cash-coin"></i>
        </div>
        <h4 class="mb-3">Preço</h4>
        <div class="mb-3">
          <%= f.label :daily_rate, "Diária (R$)", class: "form-label" %>
          <div class="input-group">
            <span class="input-group-text">R$</span>
            <%= f.number_field :daily_rate, step: 0.01, class: "form-control", required: true, placeholder: "0,00" %>
          </div>
          <div class="form-text">Valor base da diária (períodos de preço são configurados separadamente)</div>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card card-feature h-100">
        <div class="icon-wrapper mb-3" style="background-color: var(--color-success-light); color: var(--color-success);">
          <i class="bi bi-toggle-on"></i>
        </div>
        <h4 class="mb-3">Status</h4>
        <div class="mb-3">
          <%= f.label :status, "Status do Quarto", class: "form-label" %>
          <%= f.select :status, Room.statuses.keys.map { |s| [s.humanize, s] }, { include_blank: false }, class: "form-select" %>
          <div class="form-text">
            <strong>Disponível:</strong> Pronto para check-in<br>
            <strong>Ocupado:</strong> Há estadia ativa<br>
            <strong>Manutenção:</strong> Fora de serviço temporariamente
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card card-feature h-100">
        <div class="icon-wrapper mb-3" style="background-color: var(--color-warning-light); color: var(--color-warning);">
          <i class="bi bi-info-circle"></i>
        </div>
        <h4 class="mb-3">Informações</h4>
        <div class="text-muted small">
          <p class="mb-2"><strong>Períodos de preço:</strong> Configure em <code>Períodos de Preço</code> no menu lateral</p>
          <p class="mb-0"><strong>Check-in/out:</strong> O valor final é definido pelo período selecionado na estadia</p>
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex flex-column flex-sm-row justify-content-end gap-3 mt-5 pt-4 border-top" style="border-color: var(--color-border) !important;">
    <%= link_to rooms_path, class: "btn btn-secondary btn-lg d-inline-flex align-items-center gap-2" do %>
      <i class="bi bi-x-lg"></i>
      <span>Cancelar</span>
    <% end %>
    <%= f.submit "Salvar Quarto", class: "btn btn-primary btn-lg d-inline-flex align-items-center gap-2" do %>
      <i class="bi bi-check-lg"></i>
      <span>Salvar</span>
    <% end %>
  </div>
<% end %>