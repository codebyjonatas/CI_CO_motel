<%= form_with model: room, class: "row g-3" do |f| %>
  <% if room.errors.any? %>
    <div class="alert alert-danger">
      <h6><%= pluralize room.errors.count, "erro" %> ao salvar:</h6>
      <ul class="mb-0">
        <% room.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="col-md-4">
    <%= f.label :number, "Número", class: "form-label" %>
    <%= f.text_field :number, class: "form-control", required: true %>
  </div>

  <div class="col-md-4">
    <%= f.label :floor, "Andar", class: "form-label" %>
    <%= f.number_field :floor, class: "form-control" %>
  </div>

  <div class="col-md-4">
    <%= f.label :daily_rate, "Diária (R$)", class: "form-label" %>
    <%= f.number_field :daily_rate, step: 0.01, class: "form-control", required: true %>
  </div>

  <div class="col-md-4">
    <%= f.label :status, "Status", class: "form-label" %>
    <%= f.select :status, Room.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "form-select" %>
  </div>

  <div class="col-12">
    <%= f.submit "Salvar", class: "btn btn-primary" %>
    <%= link_to "Cancelar", rooms_path, class: "btn btn-secondary" %>
  </div>
<% end %>
