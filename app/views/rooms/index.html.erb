<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Quartos</h1>
  <% if policy(Room).new? %>
    <%= link_to "Novo Quarto", new_room_path, class: "btn btn-primary" %>
  <% end %>
</div>

<div class="table-responsive">
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th>Número</th>
        <th>Andar</th>
        <th>Diária</th>
        <th>Status</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @rooms.each do |room| %>
        <tr>
          <td><%= link_to room.number, room %></td>
          <td><%= room.floor %></td>
          <td><%= number_to_currency room.daily_rate %></td>
          <td>
            <span class="badge bg-<%= room.status == 'available' ? 'success' : room.status == 'occupied' ? 'warning' : 'secondary' %>">
              <%= room.status.humanize %>
            </span>
          </td>
          <td>
            <%= link_to "Ver", room, class: "btn btn-sm btn-outline-primary" %>
            <% if policy(room).edit? %>
              <%= link_to "Editar", edit_room_path(room), class: "btn btn-sm btn-outline-warning" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
