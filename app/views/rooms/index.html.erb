<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-5">
  <div>
    <span class="badge-custom badge-primary mb-2">Gestão de Quartos</span>
    <h1 class="h2 mb-0">Quartos</h1>
    <p class="text-muted small mt-1">Visualize e gerencie a ocupação dos quartos em tempo real</p>
  </div>
  <% if policy(Room).new? %>
    <%= link_to new_room_path, class: "btn btn-primary btn-lg d-inline-flex align-items-center gap-2" do %>
      <i class="bi bi-plus-lg"></i>
      <span>Novo Quarto</span>
    <% end %>
  <% end %>
</div>

<% if @rooms.any? %>
  <!-- Resumo operacional -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-2">
      <div class="card text-center border-0" style="background-color: var(--color-success-light);">
        <div class="card-body py-3">
          <div class="fs-4 fw-bold" style="color: var(--color-success);"><%= @summary[:available] %></div>
          <div class="small text-muted">Disponíveis</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-2">
      <div class="card text-center border-0" style="background-color: #FFF7ED;">
        <div class="card-body py-3">
          <div class="fs-4 fw-bold" style="color: var(--color-accent);"><%= @summary[:occupied] %></div>
          <div class="small text-muted">Ocupados</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-2">
      <div class="card bg-danger text-white text-center border-0">
        <div class="card-body py-3">
          <div class="fs-4 fw-bold"><%= @summary[:dirty] %></div>
          <div class="small">Sujos</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-2">
      <div class="card bg-info text-dark text-center border-0">
        <div class="card-body py-3">
          <div class="fs-4 fw-bold"><%= @summary[:cleaning] %></div>
          <div class="small">Em limpeza</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-2">
      <div class="card bg-secondary text-white text-center border-0">
        <div class="card-body py-3">
          <div class="fs-4 fw-bold"><%= @summary[:quarantine] %></div>
          <div class="small">Quarentena</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-2">
      <div class="card bg-dark text-white text-center border-0">
        <div class="card-body py-3">
          <div class="fs-4 fw-bold"><%= @summary[:maintenance] %></div>
          <div class="small">Manutenção</div>
        </div>
      </div>
    </div>
  </div>

  <div class="grid-3 mb-5">
    <% @rooms.each do |room| %>
      <article class="card card-feature room-card" data-room-id="<%= room.id %>">
        <div class="room-card-header">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <span class="badge-custom <%= room_status_badge_class(room.status) %> mb-2">
                <%= room_status_icon(room.status) %> <%= room_status_label(room.status) %>
              </span>
              <h3 class="h4 mb-1">Quarto <%= room.number %></h3>
              <p class="text-muted small mb-0"><i class="bi bi-building me-1"></i>Andar <%= room.floor %></p>
            </div>
            <div class="text-end">
              <div class="fw-bold text-foreground" style="font-size: 1.25rem;"><%= number_to_currency room.daily_rate %></div>
              <div class="text-muted small"> taxa base</div>
            </div>
          </div>
        </div>
        <div class="room-card-actions mt-4 pt-3 border-top" style="border-color: var(--color-border) !important;">
          <div class="d-flex gap-2">
            <%= link_to room, class: "btn btn-secondary btn-sm flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1" do %>
              <i class="bi bi-eye"></i>
              <span>Ver</span>
            <% end %>
            <%= link_to room_tabs_path(room), class: "btn btn-info btn-sm flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1" do %>
              <i class="bi bi-receipt"></i>
              <span>Comandas</span>
            <% end %>
            <% if room.status_dirty? && policy(room).start_cleaning? %>
              <%= button_to start_cleaning_room_path(room), method: :patch, class: "btn btn-danger btn-sm flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1", form: { data: { turbo_confirm: "Iniciar limpeza do quarto #{room.number}?" } } do %>
                <i class="bi bi-stars"></i>
                <span>Limpar</span>
              <% end %>
            <% elsif room.status_cleaning? && policy(room).finish_cleaning? %>
              <%= button_to finish_cleaning_room_path(room), method: :patch, class: "btn btn-info btn-sm flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1", form: { data: { turbo_confirm: "Finalizar limpeza do quarto #{room.number}?" } } do %>
                <i class="bi bi-check2-circle"></i>
                <span>Concluir</span>
              <% end %>
            <% elsif room.status_quarantine? && room.quarantine_expired? && policy(room).release_quarantine? %>
              <%= button_to release_quarantine_room_path(room), method: :patch, class: "btn btn-success btn-sm flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1", form: { data: { turbo_confirm: "Liberar quarto #{room.number} para uso?" } } do %>
                <i class="bi bi-unlock"></i>
                <span>Liberar</span>
              <% end %>
            <% end %>
            <% if policy(room).edit? %>
              <%= link_to edit_room_path(room), class: "btn btn-tertiary btn-sm flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1" do %>
                <i class="bi bi-pencil"></i>
                <span>Editar</span>
              <% end %>
            <% end %>
          </div>
        </div>
      </article>
    <% end %>
  </div>
<% else %>
  <div class="card card-feature text-center py-5">
    <div class="icon-wrapper mx-auto mb-3" style="background-color: var(--color-muted-light); color: var(--color-muted);">
      <i class="bi bi-door-open" style="font-size: 2rem;"></i>
    </div>
    <h3 class="h4 mb-2">Nenhum quarto cadastrado</h3>
    <p class="text-muted mb-4">Comece cadastrando o primeiro quarto do seu estabelecimento.</p>
    <% if policy(Room).new? %>
      <%= link_to new_room_path, class: "btn btn-primary" do %>
        <i class="bi bi-plus-lg me-2"></i>
        Cadastrar Quarto
      <% end %>
    <% end %>
  </div>
<% end %>
