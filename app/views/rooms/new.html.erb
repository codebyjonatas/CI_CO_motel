<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-5">
  <div>
    <%= link_to rooms_path, class: "btn btn-tertiary btn-sm mb-3 d-inline-flex align-items-center gap-1" do %>
      <i class="bi bi-arrow-left"></i>
      <span>Voltar</span>
    <% end %>
    <span class="badge-custom badge-primary mb-2">Novo Cadastro</span>
    <h1 class="h2 mb-0">Novo Quarto</h1>
    <p class="text-muted small mt-1">Cadastre um novo quarto no sistema</p>
  </div>
</div>

<%= render "form", room: @room %>