<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-5">
  <div>
    <%= link_to rooms_path, class: "btn btn-tertiary btn-sm mb-3 d-inline-flex align-items-center gap-1" do %>
      <i class="bi bi-arrow-left"></i>
      <span>Voltar</span>
    <% end %>
    <h1 class="h2 mb-0">Quarto <%= @room.number %></h1>
    <p class="text-muted small mt-1">Andar <%= @room.floor %></p>
  </div>
  <div class="d-flex gap-2">
    <% if policy(@room).edit? %>
      <%= link_to edit_room_path(@room), class: "btn btn-secondary btn-lg d-inline-flex align-items-center gap-2" do %>
        <i class="bi bi-pencil"></i>
        <span>Editar</span>
      <% end %>
    <% end %>
  </div>
</div>

<div class="grid-3 mb-5">
  <!-- Card Principal -->
  <article class="card card-feature" style="grid-column: span 1 / span 2;">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
      <div>
        <span class="badge-custom <%= room_status_badge_class(@room.status) %> mb-2">
          <%= room_status_icon(@room.status) %> <%= room_status_label(@room.status) %>
        </span>
        <h3 class="h3 mb-1">Detalhes do Quarto</h3>
        <p class="text-muted small mb-0">Informações cadastrais e status atual</p>
      </div>
      <div class="text-md-end mt-3 mt-md-0">
        <div class="fw-bold text-foreground" style="font-size: 2rem;"><%= number_to_currency @room.daily_rate %></div>
        <div class="text-muted small">taxa base</div>
      </div>
    </div>

    <dl class="row">
      <div class="col-md-6 mb-3">
        <dt class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing: 0.05em;">Número</dt>
        <dd class="fw-semibold text-foreground fs-5 mb-0"><%= @room.number %></dd>
      </div>
      <div class="col-md-6 mb-3">
        <dt class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing: 0.05em;">Andar</dt>
        <dd class="fw-semibold text-foreground fs-5 mb-0"><%= @room.floor %></dd>
      </div>
      <div class="col-md-6 mb-3">
        <dt class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing: 0.05em;">Taxa Base</dt>
        <dd class="fw-semibold text-foreground fs-5 mb-0"><%= number_to_currency @room.daily_rate %></dd>
      </div>
    </dl>

    <!-- Comanda Ativa (se houver) -->
    <% if @active_tab %>
      <div class="alert alert-info mb-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-3">
          <i class="bi bi-receipt fs-4"></i>
          <div>
            <div class="fw-semibold">Comanda Ativa: #<%= @active_tab.id %></div>
            <div class="text-muted small">
              <%= @active_tab.walk_in? ? "Passante: #{@active_tab.guest_identifier}" : "Estadia ##{@active_tab.stay_id}" %> •
              <%= number_to_currency @active_tab.total %>
            </div>
          </div>
        </div>
        <%= link_to room_tab_path(@room, @active_tab), class: "btn btn-info btn-sm" do %>
          <i class="bi bi-eye"></i> Ver Comanda
        <% end %>
      </div>
    <% end %>

    <!-- Ações rápidas -->
    <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top" style="border-color: var(--color-border) !important;">
      <%= link_to rooms_path, class: "btn btn-secondary d-inline-flex align-items-center gap-1" do %>
        <i class="bi bi-arrow-left"></i>
        <span>Voltar à lista</span>
      <% end %>
      <% if policy(@room).edit? %>
        <%= link_to edit_room_path(@room), class: "btn btn-primary d-inline-flex align-items-center gap-1" do %>
          <i class="bi bi-pencil"></i>
          <span>Editar quarto</span>
        <% end %>
      <% end %>
    </div>
  </article>

  <!-- Card de Ações/Status -->
  <article class="card card-feature">
    <div class="icon-wrapper mb-3" style="background-color: var(--color-primary-light); color: var(--color-primary);">
      <i class="bi bi-activity"></i>
    </div>
    <h4 class="mb-3">Ações Rápidas</h4>
    <div class="d-flex flex-column gap-2">
      <% if @room.status_available? %>
        <%= link_to new_stay_path(room_id: @room.id), class: "btn btn-primary btn-sm d-inline-flex align-items-center justify-content-center gap-2" do %>
          <i class="bi bi-door-open-fill"></i>
          <span>Fazer Check-in</span>
        <% end %>
      <% elsif @room.status_occupied? %>
        <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center justify-content-center gap-2" disabled>
          <i class="bi bi-hourglass-split"></i>
          <span>Ocupado - Check-out pendente</span>
        </button>
      <% elsif @room.status_dirty? %>
        <%= button_to start_cleaning_room_path(@room), method: :patch, class: "btn btn-danger btn-sm d-inline-flex align-items-center justify-content-center gap-2", form: { data: { turbo_confirm: "Iniciar limpeza do quarto #{@room.number}?" } } do %>
          <i class="bi bi-stars"></i>
          <span>Iniciar Limpeza</span>
        <% end %>
      <% elsif @room.status_cleaning? %>
        <%= button_to finish_cleaning_room_path(@room), method: :patch, class: "btn btn-info btn-sm d-inline-flex align-items-center justify-content-center gap-2", form: { data: { turbo_confirm: "Finalizar limpeza do quarto #{@room.number}?" } } do %>
          <i class="bi bi-check2-circle"></i>
          <span>Finalizar Limpeza</span>
        <% end %>
      <% elsif @room.status_quarantine? %>
        <% if @room.quarantine_expired? %>
          <%= button_to release_quarantine_room_path(@room), method: :patch, class: "btn btn-success btn-sm d-inline-flex align-items-center justify-content-center gap-2", form: { data: { turbo_confirm: "Liberar quarto #{@room.number} para uso?" } } do %>
            <i class="bi bi-unlock"></i>
            <span>Liberar da Quarentena</span>
          <% end %>
        <% else %>
          <button type="button" class="btn btn-secondary btn-sm d-inline-flex align-items-center justify-content-center gap-2" disabled>
            <i class="bi bi-hourglass-split"></i>
            <span>Quarentena - <%= (@room.time_until_available / 60.0).ceil %> min restantes</span>
          </button>
        <% end %>
      <% else %>
        <button type="button" class="btn btn-tertiary btn-sm d-inline-flex align-items-center justify-content-center gap-2" disabled>
          <i class="bi bi-tools"></i>
          <span>Em manutenção</span>
        </button>
      <% end %>
      <%= link_to room_tabs_path(@room), class: "btn btn-info btn-sm d-inline-flex align-items-center justify-content-center gap-2" do %>
        <i class="bi bi-receipt"></i>
        <span>Comandas do Bar</span>
      <% end %>
      <%= link_to history_room_path(@room), class: "btn btn-tertiary btn-sm d-inline-flex align-items-center justify-content-center gap-2" do %>
        <i class="bi bi-clock-history"></i>
        <span>Histórico do quarto</span>
      <% end %>
      <%= link_to stays_path(room_id: @room.id), class: "btn btn-tertiary btn-sm d-inline-flex align-items-center justify-content-center gap-2" do %>
        <i class="bi bi-journal-text"></i>
        <span>Histórico de estadias</span>
      <% end %>
    </div>
  </article>
</div>

<!-- Estadias Recentes (se houver) -->
<% if @recent_stays&.any? %>
  <section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2 class="h3 mb-0">Estadias Recentes</h2>
      <%= link_to stays_path(room_id: @room.id), class: "btn btn-tertiary btn-sm" do %>
        Ver todas <i class="bi bi-chevron-right"></i>
      <% end %>
    </div>
    <div class="card">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr class="text-muted small text-uppercase" style="letter-spacing: 0.05em;">
              <th class="border-0">Hóspede</th>
              <th class="border-0">Check-in</th>
              <th class="border-0">Check-out</th>
              <th class="border-0">Valor</th>
              <th class="border-0">Status</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_stays.first(5).each do |stay| %>
              <tr>
                <td class="fw-medium"><%= stay.user.name %></td>
                <td><%= l stay.check_in, format: :short %></td>
                <td><%= stay.check_out? ? l(stay.check_out, format: :short) : '<span class="text-muted">—</span>'.html_safe %></td>
                <td class="fw-semibold"><%= number_to_currency stay.total_value %></td>
                <td>
                  <span class="badge-custom <%= stay_status_badge_class(stay.status) %>">
                    <%= stay_status_label(stay.status) %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
<% end %>
