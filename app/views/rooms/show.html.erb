<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h1 class="card-title h4 mb-0">Quarto <%= @room.number %></h1>
    <div>
      <% if policy(@room).edit? %>
        <%= link_to "Editar", edit_room_path(@room), class: "btn btn-warning" %>
      <% end %>
      <%= link_to "Voltar", rooms_path, class: "btn btn-secondary" %>
    </div>
  </div>
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Número</dt>
      <dd class="col-sm-9"><%= @room.number %></dd>

      <dt class="col-sm-3">Andar</dt>
      <dd class="col-sm-9"><%= @room.floor %></dd>

      <dt class="col-sm-3">Diária</dt>
      <dd class="col-sm-9"><%= number_to_currency @room.daily_rate %></dd>

      <dt class="col-sm-3">Status</dt>
      <dd class="col-sm-9">
        <span class="badge bg-<%= @room.status == 'available' ? 'success' : @room.status == 'occupied' ? 'warning' : 'secondary' %>">
          <%= @room.status.humanize %>
        </span>
      </dd>
    </dl>
  </div>
</div>
