<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-5">
  <div>
    <%= link_to @stay, class: "btn btn-tertiary btn-sm mb-3 d-inline-flex align-items-center gap-1" do %>
      <i class="bi bi-arrow-left"></i>
      <span>Voltar</span>
    <% end %>
    <span class="badge-custom badge-primary mb-2">Edição</span>
    <h1 class="h2 mb-0">Editar Estadia #<%= @stay.id %></h1>
    <p class="text-muted small mt-1">
      Quarto <%= @stay.room.number %> •
      <%= stay_status_label(@stay.status) %> •
      <%= l @stay.check_in, format: :long %>
    </p>
  </div>
</div>

<%= render "form", stay: @stay %>