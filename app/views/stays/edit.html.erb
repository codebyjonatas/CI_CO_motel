<h1>Editar Estadia</h1>
<p class="text-muted">Quarto <%= @stay.room.number %> - <%= l @stay.check_in, format: :long %></p>

<%= form_with model: @stay, class: "row g-3" do |f| %>
  <% if @stay.errors.any? %>
    <div class="alert alert-danger">
      <h6><%= pluralize @stay.errors.count, "erro" %> ao salvar:</h6>
      <ul class="mb-0">
        <% @stay.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="col-md-6">
    <%= f.label :total_value, "Valor total (R$)", class: "form-label" %>
    <%= f.number_field :total_value, step: 0.01, class: "form-control" %>
    <div class="form-text">Altere aqui para adicionar cobranças extras (produtos, serviços, etc)</div>
  </div>

  <div class="col-md-6">
    <%= f.label :status, "Status", class: "form-label" %>
    <%= f.select :status, Stay.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "form-select" %>
  </div>

  <div class="col-12">
    <%= f.label :observation, "Observação", class: "form-label" %>
    <%= f.text_area :observation, class: "form-control", rows: 3 %>
    <div class="form-text">Registre aqui produtos adicionais ou observações relevantes.</div>
  </div>

  <div class="col-12">
    <%= f.submit "Atualizar", class: "btn btn-primary" %>
    <%= link_to "Cancelar", @stay, class: "btn btn-secondary" %>
  </div>
<% end %>
