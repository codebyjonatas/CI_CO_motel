<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-5">
  <div>
    <span class="badge-custom badge-primary mb-2">Painel de Estadias</span>
    <h1 class="h2 mb-0">Estadias</h1>
    <p class="text-muted small mt-1">Acompanhe check-ins, check-outs e ocupação em tempo real</p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <% if policy(Stay).new? %>
      <%= link_to new_stay_path, class: "btn btn-primary btn-lg d-inline-flex align-items-center gap-2" do %>
        <i class="bi bi-door-open-fill"></i>
        <span>Novo Check-in</span>
      <% end %>
    <% end %>
    <%= link_to stays_path, class: "btn btn-secondary btn-lg d-inline-flex align-items-center gap-2" do %>
      <i class="bi bi-arrow-clockwise"></i>
      <span>Atualizar</span>
    <% end %>
  </div>
</div>

<!-- Filtros rápidos -->
<div class="card mb-4">
  <div class="card-body py-3">
    <%= form_with url: stays_path, method: :get, class: "row g-3 align-items-end", data: { turbo: false } do |f| %>
      <div class="col-12 col-md-4 col-lg-3">
        <%= f.label :room_id, "Filtrar por quarto", class: "form-label small mb-1" %>
        <%= f.collection_select :room_id, Room.order(:number), :id, :number, { prompt: "Todos os quartos", selected: params[:room_id] }, class: "form-select form-select-sm" %>
      </div>
      <div class="col-12 col-md-4 col-lg-3">
        <%= f.label :status, "Filtrar por status", class: "form-label small mb-1" %>
        <%= f.select :status, Stay.statuses.keys.map { |s| [stay_status_label(s), s] }.unshift(["Todos", ""]), { selected: params[:status] }, class: "form-select form-select-sm" %>
      </div>
      <div class="col-6 col-md-2 col-lg-2">
        <%= f.submit "Filtrar", class: "btn btn-primary btn-sm w-100" %>
      </div>
      <div class="col-6 col-md-2 col-lg-2">
        <%= link_to stays_path, class: "btn btn-tertiary btn-sm w-100 d-inline-flex align-items-center justify-content-center gap-1" do %>
          <i class="bi bi-x-lg"></i>
          Limpar
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<% if @stays.any? %>
  <div class="card">
    <div class="table-responsive">
      <table class="table table-hover mb-0" style="--bs-table-striped-bg: var(--color-bg);">
        <thead style="background-color: var(--color-bg); border-bottom: 2px solid var(--color-border);">
          <tr class="text-muted small text-uppercase" style="letter-spacing: 0.05em;">
            <th class="border-0 ps-3 py-3 fw-semibold">Quarto</th>
            <th class="border-0 py-3 fw-semibold">Período</th>
            <th class="border-0 py-3 fw-semibold">Responsável</th>
            <th class="border-0 py-3 fw-semibold">Check-in</th>
            <th class="border-0 py-3 fw-semibold">Check-out</th>
            <th class="border-0 py-3 fw-semibold text-end">Valor</th>
            <th class="border-0 py-3 fw-semibold text-center">Status</th>
            <th class="border-0 pe-3 py-3 fw-semibold text-end">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @stays.each do |stay| %>
            <tr class="align-middle" style="border-bottom: 1px solid var(--color-border);">
              <td class="ps-3">
                <div class="d-flex align-items-center gap-2">
                  <span class="badge-custom bg-primary-light text-primary d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px; border-radius: var(--radius-md);">
                    <i class="bi bi-door-open"></i>
                  </span>
                  <div>
                    <%= link_to stay.room.number, stay, class: "fw-semibold text-foreground text-decoration-none hover-text-primary" %>
                    <div class="text-muted small"><%= stay.room.floor > 0 ? "Andar #{stay.room.floor}" : "Térreo" %></div>
                  </div>
                </div>
              </td>
              <td>
                <div class="fw-medium"><%= stay.price_period.name %></div>
                <div class="text-muted small"><%= number_to_currency stay.price_period.price %> / <%= stay.price_period.duration_minutes %>min</div>
              </td>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <div class="bg-primary-light text-primary rounded-full d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.75rem; font-weight: 600;">
                    <%= stay.user.name.first.upcase %>
                  </div>
                  <div>
                    <div class="fw-medium"><%= stay.user.name %></div>
                    <div class="text-muted small"><%= stay.user.email %></div>
                  </div>
                </div>
              </td>
              <td class="text-nowrap">
                <div class="fw-medium"><%= l stay.check_in, format: :short %></div>
                <div class="text-muted small"><%= l stay.check_in, format: "%A" %></div>
              </td>
              <td>
                <% if stay.check_out? %>
                  <div class="fw-medium"><%= l stay.check_out, format: :short %></div>
                  <div class="text-muted small"><%= l stay.check_out, format: "%A" %></div>
                <% else %>
                  <div class="text-success fw-medium d-inline-flex align-items-center gap-1">
                    <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i>
                    Em andamento
                  </div>
                  <div class="text-muted small">Desde <%= l stay.check_in, format: :short %></div>
                <% end %>
              </td>
              <td class="text-end">
                <div class="fw-bold text-foreground" style="font-size: 1.1rem;"><%= number_to_currency stay.total_value %></div>
              </td>
              <td class="text-center">
                <span class="badge-custom <%= stay_status_badge_class(stay.status) %>">
                  <%= stay_status_icon(stay.status) %> <%= stay_status_label(stay.status) %>
                </span>
              </td>
              <td class="pe-3">
                <div class="d-flex justify-content-end gap-1">
                  <%= link_to stay, class: "btn btn-secondary btn-sm d-inline-flex align-items-center gap-1", title: "Ver detalhes" do %>
                    <i class="bi bi-eye"></i>
                  <% end %>
                  <% if stay.active? %>
                    <% if policy(stay).cancel? %>
                      <%= button_to cancel_stay_path(stay), method: :patch, class: "btn btn-tertiary btn-sm d-inline-flex align-items-center gap-1", title: "Cancelar", data: { confirm: "Cancelar esta estadia?" }, form: { data: { turbo_confirm: "Cancelar esta estadia?" } } do %>
                        <i class="bi bi-x-circle"></i>
                      <% end %>
                    <% end %>
                    <%= button_to check_out_stay_path(stay), method: :patch, class: "btn btn-primary btn-sm d-inline-flex align-items-center gap-1", title: "Finalizar check-out", form: { data: { turbo_confirm: "Confirmar check-out do quarto #{stay.room.number}?" } } do %>
                      <i class="bi bi-check-circle-fill"></i>
                    <% end %>
                  <% end %>
                  <% if policy(stay).edit? %>
                    <%= link_to edit_stay_path(stay), class: "btn btn-tertiary btn-sm d-inline-flex align-items-center gap-1", title: "Editar" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                  <% end %>
                  <% if stay.cancelled? && policy(stay).destroy? %>
                    <%= button_to stay_path(stay), method: :delete, class: "btn btn-tertiary btn-sm d-inline-flex align-items-center gap-1 text-danger", title: "Excluir permanentemente", form: { data: { turbo_confirm: "Excluir permanentemente este registro?" } } do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Resumo rápido -->
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4 pt-3 border-top" style="border-color: var(--color-border) !important;">
    <div class="text-muted small">
      Total: <strong><%= @stays.count %></strong> estadias
      | Ativas: <strong class="text-primary"><%= @stays.count { |s| s.active? } %></strong>
      | Finalizadas: <strong class="text-success"><%= @stays.count { |s| s.completed? } %></strong>
      | Canceladas: <strong class="text-danger"><%= @stays.count { |s| s.cancelled? } %></strong>
    </div>
    <div class="text-muted small">
      Valor total: <strong><%= number_to_currency @stays.sum(:total_value) %></strong>
    </div>
  </div>
<% else %>
  <div class="card card-feature text-center py-5">
    <div class="icon-wrapper mx-auto mb-3" style="background-color: var(--color-muted-light); color: var(--color-muted);">
      <i class="bi bi-clock-history" style="font-size: 2rem;"></i>
    </div>
    <h3 class="h4 mb-2">Nenhuma estadia encontrada</h3>
    <p class="text-muted mb-4">Comece registrando o primeiro check-in.</p>
    <% if policy(Stay).new? %>
      <%= link_to new_stay_path, class: "btn btn-primary" do %>
        <i class="bi bi-plus-lg me-2"></i>
        Novo Check-in
      <% end %>
    <% end %>
  </div>
<% end %>