<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-5">
  <div>
    <%= link_to stays_path, class: "btn btn-tertiary btn-sm mb-3 d-inline-flex align-items-center gap-1" do %>
      <i class="bi bi-arrow-left"></i>
      <span>Voltar</span>
    <% end %>
    <span class="badge-custom badge-primary mb-2">Detalhes da Estadia</span>
    <h1 class="h2 mb-0">Estadia #<%= @stay.id %> - Quarto <%= @stay.room.number %></h1>
    <p class="text-muted small mt-1 mb-0">
      <%= stay_status_label(@stay.status) %> •
      <%= l @stay.check_in, format: :long %> •
      <%= @stay.price_period_name %>
    </p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <% if @stay.active? %>
      <% if policy(@stay).cancel? %>
        <%= button_to cancel_stay_path(@stay), method: :patch, class: "btn btn-tertiary btn-lg d-inline-flex align-items-center gap-2", form: { data: { turbo_confirm: "Cancelar estadia do quarto #{@stay.room.number}?" } } do %>
          <i class="bi bi-x-circle"></i>
          <span>Cancelar</span>
        <% end %>
      <% end %>
      <%= button_to check_out_stay_path(@stay), method: :patch, class: "btn btn-primary btn-lg d-inline-flex align-items-center gap-2", form: { data: { turbo_confirm: "Confirmar check-out do quarto #{@stay.room.number}?" } } do %>
        <i class="bi bi-check-circle-fill"></i>
        <span>Finalizar Check-out</span>
      <% end %>
    <% end %>
    <% if policy(@stay).edit? %>
      <%= link_to edit_stay_path(@stay), class: "btn btn-secondary btn-lg d-inline-flex align-items-center gap-2" do %>
        <i class="bi bi-pencil"></i>
        <span>Editar</span>
      <% end %>
    <% end %>
    <% if @stay.cancelled? && policy(@stay).destroy? %>
      <%= button_to @stay, method: :delete, class: "btn btn-tertiary btn-lg d-inline-flex align-items-center gap-2 text-danger", form: { data: { turbo_confirm: "Excluir permanentemente este registro?" } } do %>
        <i class="bi bi-trash"></i>
        <span>Excluir</span>
      <% end %>
    <% end %>
    <%= link_to "#", class: "btn btn-secondary btn-lg d-inline-flex align-items-center gap-2", onclick: "window.print(); return false;" do %>
      <i class="bi bi-printer"></i>
      <span>Imprimir</span>
    <% end %>
  </div>
</div>

<div class="row g-4 mb-5">
  <!-- Card Principal: Informações da Estadia -->
  <div class="col-lg-8">
    <article class="card h-100 d-flex flex-column">
      <div class="card-body">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
          <div class="me-md-3">
            <span class="badge-custom <%= stay_status_badge_class(@stay.status) %> mb-2">
              <%= stay_status_icon(@stay.status) %> <%= stay_status_label(@stay.status) %>
            </span>
            <h3 class="h3 mb-1">Informações da Estadia</h3>
            <p class="text-muted small mb-0">Dados cadastrais e valores</p>
          </div>
          <div class="text-md-end mt-3 mt-md-0 flex-shrink-0">
            <div class="fw-bold text-foreground" style="font-size: clamp(1.5rem, 3vw, 2.5rem);"><%= number_to_currency @stay.total_value %></div>
            <div class="text-muted small">Valor total</div>
          </div>
        </div>

        <dl class="row g-2 g-md-3 mb-0">
          <div class="col-12 col-md-6 mb-3">
            <dt class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing: 0.05em;">Quarto</dt>
            <dd class="fw-semibold text-foreground mb-0 text-break">
              <%= link_to @stay.room, class: "text-decoration-none hover-text-primary" do %>
                <i class="bi bi-door-open me-1"></i> Quarto <%= @stay.room.number %> (Andar <%= @stay.room.floor %>)
              <% end %>
            </dd>
          </div>
          <div class="col-12 col-md-6 mb-3">
            <dt class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing: 0.05em;">Período</dt>
            <dd class="fw-semibold text-foreground mb-0 text-break">
              <%= @stay.price_period_name %>
              <span class="text-muted small ms-2"><%= number_to_currency @stay.price_period_price %></span>
            </dd>
          </div>
          <div class="col-12 col-md-6 mb-3">
            <dt class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing: 0.05em;">Responsável</dt>
            <dd class="fw-semibold text-foreground mb-0 text-break">
              <div class="d-flex align-items-center gap-2">
                <div class="bg-primary-light text-primary rounded-full d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.875rem; font-weight: 600;">
                  <%= @stay.user.name.first.upcase %>
                </div>
                <div class="min-w-0">
                  <div class="text-truncate"><%= @stay.user.name %></div>
                  <div class="text-muted small text-truncate"><%= @stay.user.email %></div>
                </div>
              </div>
            </dd>
          </div>
          <div class="col-12 col-md-6 mb-3">
            <dt class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing: 0.05em;">Data / Semana</dt>
            <dd class="fw-semibold text-foreground mb-0 text-break">
              <%= l @stay.date %> • Semana <%= @stay.week_number %>
            </dd>
          </div>
          <div class="col-12 col-md-6 mb-3">
            <dt class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing: 0.05em;">Check-in</dt>
            <dd class="fw-semibold text-foreground mb-0 text-break">
              <%= l @stay.check_in, format: :long %>
            </dd>
          </div>
          <div class="col-12 col-md-6 mb-3">
            <dt class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing: 0.05em;">Check-out</dt>
            <dd class="mb-0 text-break">
              <% if @stay.check_out? %>
                <div class="fw-semibold text-foreground"><%= l @stay.check_out, format: :long %></div>
              <% else %>
                <div class="text-success fw-semibold d-inline-flex align-items-center gap-1">
                  <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> Em andamento
                </div>
                <div class="text-muted small">Iniciado em <%= l @stay.check_in, format: :short %></div>
              <% end %>
            </dd>
          </div>
          <div class="col-12 col-md-6 mb-3">
            <dt class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing: 0.05em;">Período contratado</dt>
            <dd class="fw-semibold text-foreground mb-0 text-break">
              <%= @stay.price_period_duration_minutes %> minutos
              <% if @stay.price_period_overnight? %>
                <span class="badge-custom badge-primary ms-2"><i class="bi bi-moon-fill me-1"></i>Pernoite</span>
              <% end %>
            </dd>
          </div>
          <div class="col-12 col-md-6 mb-3">
            <dt class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing: 0.05em;">Status</dt>
            <dd class="mb-0 text-break">
              <span class="badge-custom <%= stay_status_badge_class(@stay.status) %> fs-6 py-2 px-3">
                <%= stay_status_icon(@stay.status) %> <%= stay_status_label(@stay.status) %>
              </span>
            </dd>
          </div>
          <% if @stay.observation.present? %>
            <div class="col-12 mb-3">
              <dt class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing: 0.05em;">Observação</dt>
              <dd class="mb-0 text-break">
                <div class="bg-bg p-3 rounded-lg border" style="border-color: var(--color-border) !important;">
                  <%= simple_format @stay.observation %>
                </div>
              </dd>
            </div>
          <% end %>
        </dl>
      </div>

      <!-- Ações rápidas -->
      <div class="card-footer d-flex flex-wrap gap-2">
        <%= link_to stays_path, class: "btn btn-secondary d-inline-flex align-items-center gap-1" do %>
          <i class="bi bi-arrow-left"></i>
          <span>Voltar à lista</span>
        <% end %>
        <% if @stay.active? %>
          <%= button_to check_out_stay_path(@stay), method: :patch, class: "btn btn-primary d-inline-flex align-items-center gap-1", form: { data: { turbo_confirm: "Confirmar check-out do quarto #{@stay.room.number}?" } } do %>
            <i class="bi bi-check-circle-fill"></i>
            <span>Finalizar Check-out</span>
          <% end %>
          <% if policy(@stay).cancel? %>
            <%= button_to cancel_stay_path(@stay), method: :patch, class: "btn btn-tertiary d-inline-flex align-items-center gap-1", form: { data: { turbo_confirm: "Cancelar estadia do quarto #{@stay.room.number}?" } } do %>
              <i class="bi bi-x-circle"></i>
              <span>Cancelar</span>
            <% end %>
          <% end %>
        <% end %>
        <% if policy(@stay).edit? %>
          <%= link_to edit_stay_path(@stay), class: "btn btn-secondary d-inline-flex align-items-center gap-1" do %>
            <i class="bi bi-pencil"></i>
            <span>Editar valor/observação</span>
          <% end %>
        <% end %>
      </div>
    </article>
  </div>

  <!-- Card Lateral: Ações e Contexto -->
  <div class="col-lg-4">
    <article class="card h-100 d-flex flex-column">
      <div class="card-body d-flex flex-column">
        <div class="icon-wrapper mb-3" style="background-color: var(--color-accent-light); color: var(--color-accent);">
          <i class="bi bi-lightning-charge"></i>
        </div>
        <h4 class="mb-3">Ações Rápidas</h4>
        <div class="d-flex flex-column gap-2">
          <% if @stay.active? %>
            <%= button_to check_out_stay_path(@stay), method: :patch, class: "btn btn-primary d-inline-flex align-items-center justify-content-center gap-2", form: { data: { turbo_confirm: "Confirmar check-out do quarto #{@stay.room.number}?" } } do %>
              <i class="bi bi-door-closed-fill"></i>
              <span>Finalizar Check-out</span>
            <% end %>
            <% if policy(@stay).cancel? %>
              <%= button_to cancel_stay_path(@stay), method: :patch, class: "btn btn-tertiary d-inline-flex align-items-center justify-content-center gap-2", form: { data: { turbo_confirm: "Cancelar estadia do quarto #{@stay.room.number}?" } } do %>
                <i class="bi bi-x-circle"></i>
                <span>Cancelar Estadia</span>
              <% end %>
            <% end %>
          <% elsif @stay.completed? %>
            <button type="button" class="btn btn-success d-inline-flex align-items-center justify-content-center gap-2" disabled>
              <i class="bi bi-check-circle-fill"></i>
              <span>Check-out realizado</span>
            </button>
            <% if policy(@stay).edit? %>
              <%= link_to edit_stay_path(@stay), class: "btn btn-secondary d-inline-flex align-items-center justify-content-center gap-2" do %>
                <i class="bi bi-pencil"></i>
                <span>Editar valor (extras)</span>
              <% end %>
            <% end %>
          <% elsif @stay.cancelled? %>
            <button type="button" class="btn btn-tertiary d-inline-flex align-items-center justify-content-center gap-2" disabled>
              <i class="bi bi-x-circle-fill"></i>
              <span>Estadia cancelada</span>
            </button>
            <% if policy(@stay).destroy? %>
              <%= button_to @stay, method: :delete, class: "btn btn-tertiary text-danger d-inline-flex align-items-center justify-content-center gap-2", form: { data: { turbo_confirm: "Excluir permanentemente este registro?" } } do %>
                <i class="bi bi-trash"></i>
                <span>Excluir registro</span>
              <% end %>
            <% end %>
          <% end %>
          <%= link_to stays_path(room_id: @stay.room.id), class: "btn btn-tertiary d-inline-flex align-items-center justify-content-center gap-2" do %>
            <i class="bi bi-clock-history"></i>
            <span>Histórico do quarto</span>
          <% end %>
        </div>

        <hr class="my-4" style="border-color: var(--color-border) !important;">

        <h4 class="mb-3">Resumo Financeiro</h4>
        <dl class="row g-2 mb-0">
          <div class="col-6">
            <dt class="text-muted small">Período base</dt>
            <dd class="fw-semibold mb-0"><%= number_to_currency @stay.price_period_price %></dd>
          </div>
          <div class="col-6 text-end">
            <dt class="text-muted small">Total cobrado</dt>
            <dd class="fw-semibold text-primary mb-0" style="font-size: 1.1rem;"><%= number_to_currency @stay.total_value %></dd>
          </div>
          <% if @stay.total_value > @stay.price_period_price %>
            <div class="col-6">
              <dt class="text-muted small">Extras</dt>
              <dd class="fw-semibold text-warning mb-0">+<%= number_to_currency @stay.total_value - @stay.price_period_price %></dd>
            </div>
            <div class="col-6 text-end">
              <dt class="text-muted small">Diferença</dt>
              <dd class="fw-semibold text-warning mb-0"><%= number_to_currency @stay.total_value - @stay.price_period_price %></dd>
            </div>
          <% end %>
        </dl>
      </div>
    </article>
  </div>
</div>
