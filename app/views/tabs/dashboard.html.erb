<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-receipt me-2"></i>Central de Comandas</h1>
    <div class="d-flex gap-2">
      <div class="dropdown">
        <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="bi bi-plus-lg me-1"></i> Nova Comanda
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          <% if @eligible_rooms.any? %>
            <% @eligible_rooms.each do |room| %>
              <li>
                <%= link_to new_room_tab_path(room), class: "dropdown-item d-flex justify-content-between align-items-center" do %>
                  <span>Quarto <%= room.number %></span>
                  <span class="badge <%= room.status_badge_class %>"><%= room.status.humanize %></span>
                <% end %>
              </li>
            <% end %>
          <% else %>
            <li>
              <span class="dropdown-item-text text-muted small">
                Nenhum quarto apto agora (disponível ou ocupado sem comanda aberta)
              </span>
            </li>
          <% end %>
        </ul>
      </div>
      <%= link_to rooms_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-door-open me-1"></i> Por Quarto
      <% end %>
      <%= link_to tabs_report_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-graph-up me-1"></i> Relatórios
      <% end %>
    </div>
  </div>

  <!-- Cards de Resumo -->
  <div class="row g-3 mb-4">
    <div class="col-md-2">
      <div class="card bg-success text-white">
        <div class="card-body text-center">
          <div class="fs-3 fw-bold"><%= @summary[:open] %></div>
          <div class="small">Abertas</div>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card bg-warning text-dark">
        <div class="card-body text-center">
          <div class="fs-3 fw-bold"><%= @summary[:closed] %></div>
          <div class="small">Fechadas (aguardando)</div>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card bg-dark text-white">
        <div class="card-body text-center">
          <div class="fs-3 fw-bold"><%= @summary[:paid] %></div>
          <div class="small">Pagas</div>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card bg-danger text-white">
        <div class="card-body text-center">
          <div class="fs-3 fw-bold"><%= @summary[:cancelled] %></div>
          <div class="small">Canceladas</div>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card bg-info text-white">
        <div class="card-body text-center">
          <div class="fs-4 fw-bold"><%= number_to_currency(@summary[:total_pending_value]) %></div>
          <div class="small">Total Pendente</div>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card bg-primary text-white">
        <div class="card-body text-center">
          <div class="fs-4 fw-bold"><%= number_to_currency(@summary[:total_paid_today]) %></div>
          <div class="small">Recebido Hoje</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filtros -->
  <div class="card mb-4">
    <div class="card-body">
      <%= form_with url: tabs_dashboard_path, method: :get, class: "row g-3", local: true do |f| %>
        <div class="col-md-3">
          <%= f.label :status, "Status", class: "form-label small" %>
          <%= f.select :status, Tab.statuses.keys.map { |s| [s.humanize, s] }.unshift(["Todos", ""]), { selected: params[:status] }, class: "form-select form-select-sm" %>
        </div>
        <div class="col-md-3">
          <%= f.label :room_id, "Quarto", class: "form-label small" %>
          <%= f.collection_select :room_id, @rooms, :id, :number, { prompt: "Todos", selected: params[:room_id] }, class: "form-select form-select-sm" %>
        </div>
        <div class="col-md-2">
          <%= f.label :date_from, "De", class: "form-label small" %>
          <%= f.date_field :date_from, class: "form-control form-control-sm", value: params[:date_from] %>
        </div>
        <div class="col-md-2">
          <%= f.label :date_to, "Até", class: "form-label small" %>
          <%= f.date_field :date_to, class: "form-control form-control-sm", value: params[:date_to] %>
        </div>
        <div class="col-md-2 d-flex align-items-end">
          <%= f.submit "Filtrar", class: "btn btn-primary w-100" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Tabela de Comandas -->
  <div class="card">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>ID</th>
              <th>Quarto</th>
              <th>Cliente / Estadia</th>
              <th>Tipo</th>
              <th>Status</th>
              <th>Itens</th>
              <th class="text-end">Subtotal</th>
              <th class="text-end">Desc.</th>
              <th class="text-end"><strong>Total</strong></th>
              <th>Abertura</th>
              <th>Fechamento</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @tabs.each do |tab| %>
              <tr>
                <td><%= tab.id %></td>
                <td>
                  <span class="badge <%= tab.room.status_badge_class %>">
                    <%= tab.room.number %>
                  </span>
                </td>
                <td>
                  <div class="fw-medium"><%= tab.guest_identifier %></div>
                  <% if tab.stay %>
                    <div class="text-muted small">Estadia ##{tab.stay_id}</div>
                  <% end %>
                </td>
                <td>
                  <% if tab.walk_in? %>
                    <span class="badge bg-warning text-dark">Passante</span>
                  <% else %>
                    <span class="badge bg-info">Estadia</span>
                  <% end %>
                </td>
                <td><%= badge_for_tab_status(tab.status) %></td>
                <td><%= tab.active_items.count %></td>
                <td class="text-end"><%= number_to_currency(tab.subtotal) %></td>
                <td class="text-end"><%= number_to_currency(tab.discount) %></td>
                <td class="text-end fw-bold"><%= number_to_currency(tab.total) %></td>
                <td><%= l(tab.created_at, format: :short) %></td>
                <td><%= tab.closed_at ? l(tab.closed_at, format: :short) : "-" %></td>
                <td>
                  <div class="btn-group btn-group-sm" role="group">
                    <%= link_to room_tab_path(tab.room, tab), class: "btn btn-outline-primary", title: "Ver" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <% if tab.open? %>
                      <%= button_to close_room_tab_path(tab.room, tab), method: :patch, class: "btn btn-outline-success", form: { data: { turbo_confirm: "Fechar comanda?" } }, title: "Fechar" do %>
                        <i class="bi bi-check-circle"></i>
                      <% end %>
                      <% if policy(tab).pay? %>
                        <%= button_to pay_room_tab_path(tab.room, tab), method: :patch, class: "btn btn-outline-dark", form: { data: { turbo_confirm: "Marcar como paga?" } }, title: "Pagar" do %>
                          <i class="bi bi-cash"></i>
                        <% end %>
                      <% end %>
                      <%= link_to "#add-item-modal-#{tab.id}", class: "btn btn-outline-info", data: { bs_toggle: "modal", bs_target: "#addItemModal#{tab.id}" }, title: "Add Item" do %>
                        <i class="bi bi-plus"></i>
                      <% end %>
                    <% elsif tab.closed? && policy(tab).pay? %>
                      <%= button_to pay_room_tab_path(tab.room, tab), method: :patch, class: "btn btn-outline-dark", form: { data: { turbo_confirm: "Confirmar pagamento?" } }, title: "Pagar" do %>
                        <i class="bi bi-cash"></i>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>

              <!-- Modal Adicionar Item (por comanda) -->
              <div class="modal fade" id="addItemModal<%= tab.id %>" tabindex="-1">
                <div class="modal-dialog modal-lg">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title">Adicionar Item - Comanda ##{tab.id}</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <%= form_with url: room_tab_tab_items_path(tab.room, tab), local: true do |f| %>
                      <div class="modal-body">
                        <div class="row mb-3">
                          <div class="col-md-6">
                            <%= f.label :product_id, "Produto", class: "form-label" %>
                            <%= f.collection_select :product_id, Product.active.ordered, :id, :name, { prompt: "Selecione...", include_blank: false }, { class: "form-select" } %>
                          </div>
                          <div class="col-md-3">
                            <%= f.label :quantity, "Quantidade", class: "form-label" %>
                            <%= f.number_field :quantity, value: 1, min: 1, class: "form-control" %>
                          </div>
                          <div class="col-md-3">
                            <%= f.label :unit_price, "Preço Unit. (opcional)", class: "form-label" %>
                            <%= f.number_field :unit_price, step: "0.01", min: "0", class: "form-control", placeholder: "Padrão do produto" %>
                          </div>
                        </div>
                        <div class="mb-3">
                          <%= f.label :notes, "Observações", class: "form-label" %>
                          <%= f.text_field :notes, class: "form-control", placeholder: "Ex: Sem gelo, bem gelado" %>
                        </div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <%= f.submit "Adicionar", class: "btn btn-primary" %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Paginação -->
      <% if @tabs.total_pages > 1 %>
        <div class="card-footer p-3">
          <%= paginate @tabs, theme: 'bootstrap-5' %>
        </div>
      <% end %>
    </div>
  </div>

  <% if @tabs.empty? %>
    <div class="text-center py-5">
      <i class="bi bi-receipt-cutoff display-1 text-muted"></i>
      <p class="text-muted mt-3">Nenhuma comanda encontrada com os filtros atuais</p>
    </div>
  <% end %>
</div>
