<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-5">
  <div>
    <%= link_to room_path(@room), class: "btn btn-tertiary btn-sm mb-3 d-inline-flex align-items-center gap-1" do %>
      <i class="bi bi-arrow-left"></i>
      <span>Voltar</span>
    <% end %>
    <h1 class="h2 mb-0">Comandas do Quarto <%= @room.number %></h1>
    <p class="text-muted small mt-1 mb-0">
      Andar <%= @room.floor %> • <%= number_to_currency @room.daily_rate %>/diária
    </p>
    <div class="mt-2">
      <span class="badge-custom <%= room_status_badge_class(@room.status) %>">
        <%= room_status_icon(@room.status) %> <%= room_status_label(@room.status) %>
      </span>
    </div>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <%= link_to new_room_tab_path(@room), class: "btn btn-primary d-inline-flex align-items-center gap-2" do %>
      <i class="bi bi-plus-lg"></i>
      <span>Nova Comanda (Estadia)</span>
    <% end %>
    <%= link_to new_room_tab_path(@room, walk_in: true), class: "btn btn-secondary d-inline-flex align-items-center gap-2" do %>
      <i class="bi bi-person-walking"></i>
      <span>Nova Comanda (Passante)</span>
    <% end %>
  </div>
</div>

<% if @active_tab %>
  <div class="card mb-4" style="background-color: var(--color-primary-light); border-color: var(--color-primary);">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
      <div class="d-flex align-items-center gap-3">
        <div class="icon-wrapper flex-shrink-0" style="margin-bottom: 0; background-color: var(--color-surface); color: var(--color-primary);">
          <i class="bi bi-receipt"></i>
        </div>
        <div>
          <div class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.05em;">Comanda aberta</div>
          <div class="fw-semibold text-foreground">
            #<%= @active_tab.id %> • <%= @active_tab.guest_identifier %>
            <% if @active_tab.walk_in? %>
              <span class="badge-custom badge-warning ms-1"><i class="bi bi-person-walking me-1" aria-hidden="true"></i>Passante</span>
            <% end %>
          </div>
          <div class="text-muted small"><%= number_to_currency(@active_tab.total) %> em <%= @active_tab.active_items.count %> item(ns)</div>
        </div>
      </div>
      <%= link_to room_tab_path(@room, @active_tab), class: "btn btn-primary d-inline-flex align-items-center gap-2" do %>
        <i class="bi bi-eye"></i>
        <span>Ver comanda</span>
      <% end %>
    </div>
  </div>
<% end %>

<article class="card">
  <div class="card-header d-flex align-items-center gap-2">
    <i class="bi bi-clock-history text-primary"></i>
    <h2 class="h5 mb-0">Histórico de Comandas</h2>
  </div>
  <div class="card-body p-0">
    <% if @tabs.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead style="background-color: var(--color-bg); border-bottom: 2px solid var(--color-border);">
            <tr class="text-muted small text-uppercase" style="letter-spacing: 0.05em;">
              <th class="border-0 ps-3 py-3 fw-semibold">ID</th>
              <th class="border-0 py-3 fw-semibold">Cliente</th>
              <th class="border-0 py-3 fw-semibold">Tipo</th>
              <th class="border-0 py-3 fw-semibold">Status</th>
              <th class="border-0 py-3 fw-semibold text-center">Itens</th>
              <th class="border-0 py-3 fw-semibold text-end">Subtotal</th>
              <th class="border-0 py-3 fw-semibold text-end">Desc.</th>
              <th class="border-0 py-3 fw-semibold text-end">Total</th>
              <th class="border-0 py-3 fw-semibold">Abertura</th>
              <th class="border-0 py-3 fw-semibold">Fechamento</th>
              <th class="border-0 pe-3 py-3 fw-semibold text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @tabs.each do |tab| %>
              <tr class="align-middle" style="border-bottom: 1px solid var(--color-border);">
                <td class="ps-3 fw-semibold">#<%= tab.id %></td>
                <td class="text-break"><%= tab.guest_identifier %></td>
                <td><%= tab_type_badge(tab) %></td>
                <td><%= badge_for_tab_status(tab.status) %></td>
                <td class="text-center"><%= tab.tab_items.active.count %></td>
                <td class="text-end"><%= number_to_currency(tab.subtotal) %></td>
                <td class="text-end text-muted"><%= number_to_currency(tab.discount) %></td>
                <td class="text-end fw-semibold"><%= number_to_currency(tab.total) %></td>
                <td class="text-nowrap"><%= l(tab.created_at, format: :short) %></td>
                <td class="text-nowrap"><%= tab.closed_at ? l(tab.closed_at, format: :short) : "—" %></td>
                <td class="pe-3 text-end">
                  <div class="d-inline-flex gap-1">
                    <%= link_to room_tab_path(@room, tab), class: "btn btn-tertiary btn-xs", title: "Ver comanda" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <% if tab.open? %>
                      <%= button_to close_room_tab_path(@room, tab), method: :patch, class: "btn btn-tertiary btn-xs", title: "Fechar comanda", form: { data: { turbo_confirm: "Fechar comanda ##{tab.id}?" } } do %>
                        <i class="bi bi-lock"></i>
                      <% end %>
                      <% if policy(tab).pay? %>
                        <%= button_to pay_room_tab_path(@room, tab), method: :patch, class: "btn btn-tertiary btn-xs", title: "Marcar como paga", form: { data: { turbo_confirm: "Marcar comanda ##{tab.id} como paga?" } } do %>
                          <i class="bi bi-cash-coin"></i>
                        <% end %>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5">
        <div class="icon-wrapper mx-auto mb-3" style="background-color: #F1F5F9; color: var(--color-muted);">
          <i class="bi bi-receipt-cutoff"></i>
        </div>
        <p class="text-muted mb-3">Nenhuma comanda registrada para este quarto.</p>
        <%= link_to new_room_tab_path(@room), class: "btn btn-primary d-inline-flex align-items-center gap-2" do %>
          <i class="bi bi-plus-lg"></i>
          <span>Abrir primeira comanda</span>
        <% end %>
      </div>
    <% end %>
  </div>
</article>
