<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-5">
  <div>
    <%= link_to room_tabs_path(@room), class: "btn btn-tertiary btn-sm mb-3 d-inline-flex align-items-center gap-1" do %>
      <i class="bi bi-arrow-left"></i>
      <span>Voltar</span>
    <% end %>
    <span class="badge-custom badge-accent mb-2"><i class="bi bi-plus-lg me-1"></i>Nova Comanda</span>
    <h1 class="h2 mb-0"><%= @walk_in ? "Comanda Passante" : "Nova Comanda" %></h1>
    <p class="text-muted small mt-1 mb-0">
      <i class="bi bi-door-open me-1"></i>Quarto <%= @room.number %> • Andar <%= @room.floor %>
    </p>
  </div>
</div>

<div class="row justify-content-center">
  <div class="col-12 col-lg-8">
    <article class="card">
      <div class="card-header d-flex align-items-center gap-2">
        <i class="bi <%= @walk_in ? 'bi-person-walking' : 'bi-journal-text' %> text-primary"></i>
        <h2 class="h5 mb-0"><%= @walk_in ? "Dados do Cliente Passante" : "Selecionar Estadia" %></h2>
      </div>
      <div class="card-body">
        <%= form_with url: @walk_in ? create_walk_in_room_tabs_path(@room) : room_tabs_path(@room), method: :post, local: true do |f| %>
          <% if @walk_in %>
            <div class="mb-3">
              <%= f.label :guest_identifier, "Identificação do cliente *", class: "form-label" %>
              <%= f.text_field :guest_identifier, class: "form-control", required: true, placeholder: "Ex: João Silva, Mesa 3, CPF 123..." %>
              <div class="form-text">Nome, documento ou identificação da mesa.</div>
            </div>
          <% else %>
            <div class="mb-3">
              <%= f.label :stay_id, "Estadia ativa *", class: "form-label" %>
              <%= f.collection_select :stay_id, @stays, :id, ->(s) { "##{s.id} — Quarto #{s.room.number} (#{s.user.name})" }, { prompt: "Selecione a estadia..." }, { class: "form-select", required: true } %>
              <div class="form-text">A comanda será vinculada a esta estadia.</div>
            </div>
            <div class="mb-3">
              <%= f.label :guest_identifier, "Identificação (opcional)", class: "form-label" %>
              <%= f.text_field :guest_identifier, class: "form-control", placeholder: "Sobrescreve o nome do hóspede principal" %>
            </div>
          <% end %>

          <div class="mb-4">
            <%= f.label :notes, "Observações", class: "form-label" %>
            <%= f.text_area :notes, rows: 2, class: "form-control", placeholder: "Ex: Cliente VIP, anotar preferências..." %>
          </div>

          <div class="d-flex flex-wrap gap-2 pt-4 border-top" style="border-color: var(--color-border) !important;">
            <%= f.submit @walk_in ? "Abrir Comanda Passante" : "Abrir Comanda", class: "btn btn-primary btn-lg" %>
            <%= link_to "Cancelar", room_tabs_path(@room), class: "btn btn-tertiary btn-lg" %>
          </div>
        <% end %>
      </div>
    </article>
  </div>
</div>

<!-- Modal info para estadias (apenas para não walk-in) -->
<% unless @walk_in %>
  <div class="modal fade" id="stayInfoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Detalhes da Estadia</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body" id="stayInfoContent">
          Selecione uma estadia para ver os detalhes
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('turbo:load', function() {
      const staySelect = document.querySelector('select[name="stay_id"]');
      if (!staySelect || staySelect.dataset.bound === 'true') return;
      staySelect.dataset.bound = 'true';

      staySelect.addEventListener('change', function() {
        const stayId = this.value;
        if (!stayId) return;

        fetch('/stays/' + stayId + '/info')
          .then(response => response.json())
          .then(data => {
            document.getElementById('stayInfoContent').innerHTML =
              '<strong>Quarto:</strong> ' + data.room_number + '<br>' +
              '<strong>Hóspede:</strong> ' + data.guest_name + '<br>' +
              '<strong>Check-in:</strong> ' + data.check_in + '<br>' +
              '<strong>Período:</strong> ' + data.price_period;
            new bootstrap.Modal(document.getElementById('stayInfoModal')).show();
          });
      });
    });
</script>
<% end %>
