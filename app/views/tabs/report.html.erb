<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <%= link_to tabs_dashboard_path, class: "btn btn-tertiary btn-sm mb-3 d-inline-flex align-items-center gap-1" do %>
        <i class="bi bi-arrow-left"></i>
        <span>Voltar às comandas</span>
      <% end %>
      <h1><i class="bi bi-graph-up me-2"></i>Relatórios de Faturamento</h1>
      <p class="text-muted small mb-0">Receita consolidada das comandas pagas.</p>
    </div>
  </div>

  <!-- Filtros -->
  <div class="card mb-4">
    <div class="card-body">
      <%= form_with url: tabs_report_path, method: :get, class: "row g-3", local: true do |f| %>
        <div class="col-md-4">
          <%= f.label :date_from, "De", class: "form-label small" %>
          <%= f.date_field :date_from, class: "form-control form-control-sm", value: @report[:date_from] %>
        </div>
        <div class="col-md-4">
          <%= f.label :date_to, "Até", class: "form-label small" %>
          <%= f.date_field :date_to, class: "form-control form-control-sm", value: @report[:date_to] %>
        </div>
        <div class="col-md-4 d-flex align-items-end">
          <%= f.submit "Filtrar", class: "btn btn-primary w-100" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Cards de Resumo -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="card bg-primary text-white">
        <div class="card-body text-center">
          <div class="fs-4 fw-bold"><%= number_to_currency(@report[:total_revenue]) %></div>
          <div class="small">Receita Total</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card bg-success text-white">
        <div class="card-body text-center">
          <div class="fs-4 fw-bold"><%= @report[:paid_tabs_count] %></div>
          <div class="small">Comandas Pagas</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card bg-info text-white">
        <div class="card-body text-center">
          <div class="fs-4 fw-bold"><%= number_to_currency(@report[:average_ticket]) %></div>
          <div class="small">Ticket Médio</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card bg-warning text-dark">
        <div class="card-body text-center">
          <div class="fs-4 fw-bold"><%= number_to_currency(@report[:open_value] + @report[:closed_value]) %></div>
          <div class="small">Em Aberto</div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- Receita por dia -->
    <div class="col-12 col-lg-6">
      <div class="card h-100">
        <div class="card-header fw-semibold"><i class="bi bi-calendar3 me-1"></i> Receita por Dia</div>
        <div class="card-body p-0">
          <% if @report[:revenue_by_day].any? %>
            <table class="table table-sm table-striped mb-0">
              <thead class="table-light">
                <tr><th>Dia</th><th class="text-end">Receita</th></tr>
              </thead>
              <tbody>
                <% @report[:revenue_by_day].sort_by { |day, _| day.to_s }.reverse.each do |day, value| %>
                  <tr>
                    <td><%= l(day.to_date, format: :default) %></td>
                    <td class="text-end"><%= number_to_currency(value) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-muted small p-3 mb-0">Sem receita no período.</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Receita por quarto -->
    <div class="col-12 col-lg-6">
      <div class="card h-100">
        <div class="card-header fw-semibold"><i class="bi bi-door-open me-1"></i> Receita por Quarto</div>
        <div class="card-body p-0">
          <% if @report[:revenue_by_room].any? %>
            <table class="table table-sm table-striped mb-0">
              <thead class="table-light">
                <tr><th>Quarto</th><th class="text-end">Receita</th></tr>
              </thead>
              <tbody>
                <% @report[:revenue_by_room].sort_by { |_, value| -value.to_f }.each do |number, value| %>
                  <tr>
                    <td>Quarto <%= number %></td>
                    <td class="text-end"><%= number_to_currency(value) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-muted small p-3 mb-0">Sem receita no período.</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Receita por atendente -->
    <div class="col-12 col-lg-6">
      <div class="card h-100">
        <div class="card-header fw-semibold"><i class="bi bi-person-badge me-1"></i> Receita por Atendente</div>
        <div class="card-body p-0">
          <% if @report[:revenue_by_attendant].any? %>
            <table class="table table-sm table-striped mb-0">
              <thead class="table-light">
                <tr><th>Atendente</th><th class="text-end">Receita</th></tr>
              </thead>
              <tbody>
                <% @report[:revenue_by_attendant].sort_by { |_, value| -value.to_f }.each do |name, value| %>
                  <tr>
                    <td><%= name %></td>
                    <td class="text-end"><%= number_to_currency(value) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-muted small p-3 mb-0">Sem receita no período.</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Top produtos -->
    <div class="col-12 col-lg-6">
      <div class="card h-100">
        <div class="card-header fw-semibold"><i class="bi bi-trophy me-1"></i> Produtos Mais Vendidos</div>
        <div class="card-body p-0">
          <% if @report[:top_products].any? %>
            <table class="table table-sm table-striped mb-0">
              <thead class="table-light">
                <tr><th>Produto</th><th class="text-end">Receita</th></tr>
              </thead>
              <tbody>
                <% @report[:top_products].each do |name, value| %>
                  <tr>
                    <td><%= name %></td>
                    <td class="text-end"><%= number_to_currency(value) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-muted small p-3 mb-0">Sem produtos vendidos no período.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
