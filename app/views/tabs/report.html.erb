<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-5">
  <div>
    <%= link_to tabs_dashboard_path, class: "btn btn-tertiary btn-sm mb-3 d-inline-flex align-items-center gap-1" do %>
      <i class="bi bi-arrow-left"></i>
      <span>Voltar às comandas</span>
    <% end %>
    <h1 class="h2 mb-0">Relatórios de Faturamento</h1>
    <p class="text-muted small mt-1 mb-0">Receita consolidada das comandas pagas.</p>
  </div>
</div>

<!-- Filtros -->
<div class="card mb-4">
  <div class="card-body">
    <%= form_with url: tabs_report_path, method: :get, class: "row g-3", local: true do |f| %>
      <div class="col-12 col-md-4">
        <%= f.label :date_from, "De", class: "form-label" %>
        <%= f.date_field :date_from, class: "form-control", value: @report[:date_from] %>
      </div>
      <div class="col-12 col-md-4">
        <%= f.label :date_to, "Até", class: "form-label" %>
        <%= f.date_field :date_to, class: "form-control", value: @report[:date_to] %>
      </div>
      <div class="col-12 col-md-4 d-flex align-items-end">
        <%= f.submit "Filtrar", class: "btn btn-primary w-100" %>
      </div>
    <% end %>
  </div>
</div>

<!-- Cards de Resumo -->
<div class="row g-3 mb-4">
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="stat-card">
      <div class="stat-icon"><i class="bi bi-currency-dollar"></i></div>
      <div>
        <div class="stat-value"><%= number_to_currency(@report[:total_revenue]) %></div>
        <div class="stat-label">Receita total</div>
      </div>
    </div>
  </div>
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="stat-card stat-card-success">
      <div class="stat-icon"><i class="bi bi-receipt"></i></div>
      <div>
        <div class="stat-value"><%= @report[:paid_tabs_count] %></div>
        <div class="stat-label">Comandas pagas</div>
      </div>
    </div>
  </div>
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="stat-card stat-card-info">
      <div class="stat-icon"><i class="bi bi-bar-chart"></i></div>
      <div>
        <div class="stat-value"><%= number_to_currency(@report[:average_ticket]) %></div>
        <div class="stat-label">Ticket médio</div>
      </div>
    </div>
  </div>
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="stat-card stat-card-warning">
      <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
      <div>
        <div class="stat-value"><%= number_to_currency(@report[:open_value].to_f + @report[:closed_value].to_f) %></div>
        <div class="stat-label">Em aberto</div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- Receita por dia -->
  <div class="col-12 col-lg-6">
    <article class="card h-100">
      <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-calendar3 text-primary"></i>
        <h2 class="h5 mb-0">Receita por dia</h2>
      </div>
      <div class="card-body p-0">
        <% if @report[:revenue_by_day].any? %>
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead style="background-color: var(--color-bg); border-bottom: 2px solid var(--color-border);">
                <tr class="text-muted small text-uppercase" style="letter-spacing: 0.05em;">
                  <th class="border-0 ps-3 py-3 fw-semibold">Dia</th>
                  <th class="border-0 pe-3 py-3 fw-semibold text-end">Receita</th>
                </tr>
              </thead>
              <tbody>
                <% @report[:revenue_by_day].sort_by { |day, _| day.to_s }.reverse.each do |day, value| %>
                  <tr class="align-middle" style="border-bottom: 1px solid var(--color-border);">
                    <td class="ps-3"><%= l(day.to_date, format: :default) %></td>
                    <td class="pe-3 text-end fw-semibold"><%= number_to_currency(value) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-muted small p-4 mb-0">Sem receita no período.</p>
        <% end %>
      </div>
    </article>
  </div>

  <!-- Receita por quarto -->
  <div class="col-12 col-lg-6">
    <article class="card h-100">
      <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-door-open text-primary"></i>
        <h2 class="h5 mb-0">Receita por quarto</h2>
      </div>
      <div class="card-body p-0">
        <% if @report[:revenue_by_room].any? %>
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead style="background-color: var(--color-bg); border-bottom: 2px solid var(--color-border);">
                <tr class="text-muted small text-uppercase" style="letter-spacing: 0.05em;">
                  <th class="border-0 ps-3 py-3 fw-semibold">Quarto</th>
                  <th class="border-0 pe-3 py-3 fw-semibold text-end">Receita</th>
                </tr>
              </thead>
              <tbody>
                <% @report[:revenue_by_room].sort_by { |_, value| -value.to_f }.each do |number, value| %>
                  <tr class="align-middle" style="border-bottom: 1px solid var(--color-border);">
                    <td class="ps-3">Quarto <%= number %></td>
                    <td class="pe-3 text-end fw-semibold"><%= number_to_currency(value) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-muted small p-4 mb-0">Sem receita no período.</p>
        <% end %>
      </div>
    </article>
  </div>

  <!-- Receita por atendente -->
  <div class="col-12 col-lg-6">
    <article class="card h-100">
      <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-person-badge text-primary"></i>
        <h2 class="h5 mb-0">Receita por atendente</h2>
      </div>
      <div class="card-body p-0">
        <% if @report[:revenue_by_attendant].any? %>
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead style="background-color: var(--color-bg); border-bottom: 2px solid var(--color-border);">
                <tr class="text-muted small text-uppercase" style="letter-spacing: 0.05em;">
                  <th class="border-0 ps-3 py-3 fw-semibold">Atendente</th>
                  <th class="border-0 pe-3 py-3 fw-semibold text-end">Receita</th>
                </tr>
              </thead>
              <tbody>
                <% @report[:revenue_by_attendant].sort_by { |_, value| -value.to_f }.each do |name, value| %>
                  <tr class="align-middle" style="border-bottom: 1px solid var(--color-border);">
                    <td class="ps-3"><%= name %></td>
                    <td class="pe-3 text-end fw-semibold"><%= number_to_currency(value) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-muted small p-4 mb-0">Sem receita no período.</p>
        <% end %>
      </div>
    </article>
  </div>

  <!-- Top produtos -->
  <div class="col-12 col-lg-6">
    <article class="card h-100">
      <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-trophy text-primary"></i>
        <h2 class="h5 mb-0">Produtos mais vendidos</h2>
      </div>
      <div class="card-body p-0">
        <% if @report[:top_products].any? %>
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead style="background-color: var(--color-bg); border-bottom: 2px solid var(--color-border);">
                <tr class="text-muted small text-uppercase" style="letter-spacing: 0.05em;">
                  <th class="border-0 ps-3 py-3 fw-semibold">Produto</th>
                  <th class="border-0 pe-3 py-3 fw-semibold text-end">Receita</th>
                </tr>
              </thead>
              <tbody>
                <% @report[:top_products].each do |name, value| %>
                  <tr class="align-middle" style="border-bottom: 1px solid var(--color-border);">
                    <td class="ps-3"><%= name %></td>
                    <td class="pe-3 text-end fw-semibold"><%= number_to_currency(value) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-muted small p-4 mb-0">Sem produtos vendidos no período.</p>
        <% end %>
      </div>
    </article>
  </div>
</div>
