<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-5">
  <div>
    <%= link_to room_tabs_path(@tab.room), class: "btn btn-tertiary btn-sm mb-3 d-inline-flex align-items-center gap-1" do %>
      <i class="bi bi-arrow-left"></i>
      <span>Voltar</span>
    <% end %>
    <h1 class="h2 mb-0">Comanda #<%= @tab.id %></h1>
    <p class="text-muted small mt-1 mb-0 d-flex flex-wrap align-items-center gap-2">
      <span><i class="bi bi-door-open me-1"></i>Quarto <%= @tab.room.number %></span>
      <span aria-hidden="true">•</span>
      <span><%= @tab.walk_in? ? "Passante: #{@tab.guest_identifier}" : "Estadia ##{@tab.stay_id}" %></span>
    </p>
    <div class="mt-2">
      <%= badge_for_tab_status(@tab.status) %>
    </div>
  </div>

  <div class="d-flex flex-wrap gap-2">
    <% if @tab.open? %>
      <%= link_to "#", class: "btn btn-primary d-inline-flex align-items-center gap-2", data: { bs_toggle: "modal", bs_target: "#addItemModal" } do %>
        <i class="bi bi-plus-lg"></i>
        <span>Adicionar Item</span>
      <% end %>
      <%= button_to close_room_tab_path(@tab.room, @tab), method: :patch, class: "btn btn-secondary d-inline-flex align-items-center gap-2", form: { data: { turbo_confirm: "Fechar comanda ##{@tab.id}?" } } do %>
        <i class="bi bi-lock"></i>
        <span>Fechar Comanda</span>
      <% end %>
      <% if policy(@tab).pay? %>
        <%= button_to pay_room_tab_path(@tab.room, @tab), method: :patch, class: "btn btn-secondary d-inline-flex align-items-center gap-2", form: { data: { turbo_confirm: "Marcar comanda ##{@tab.id} como paga?" } } do %>
          <i class="bi bi-cash-coin"></i>
          <span>Marcar como Paga</span>
        <% end %>
      <% end %>
      <% if policy(@tab).transfer? %>
        <%= link_to "#", class: "btn btn-tertiary d-inline-flex align-items-center gap-2", data: { bs_toggle: "modal", bs_target: "#transferModal" } do %>
          <i class="bi bi-arrow-left-right"></i>
          <span>Transferir</span>
        <% end %>
      <% end %>
      <% if policy(@tab).cancel? %>
        <%= link_to "#", class: "btn btn-tertiary text-danger d-inline-flex align-items-center gap-2", data: { bs_toggle: "modal", bs_target: "#cancelModal" } do %>
          <i class="bi bi-x-circle"></i>
          <span>Cancelar</span>
        <% end %>
      <% end %>
    <% elsif @tab.closed? %>
      <% if policy(@tab).pay? %>
        <%= button_to pay_room_tab_path(@tab.room, @tab), method: :patch, class: "btn btn-primary d-inline-flex align-items-center gap-2", form: { data: { turbo_confirm: "Confirmar pagamento da comanda ##{@tab.id}?" } } do %>
          <i class="bi bi-cash-coin"></i>
          <span>Marcar como Paga</span>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-lg-6">
    <article class="card h-100">
      <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-info-circle text-primary"></i>
        <h2 class="h5 mb-0">Informações</h2>
      </div>
      <div class="card-body">
        <dl class="row g-2 mb-0">
          <div class="col-12 col-sm-6">
            <dt class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing: 0.05em;">Cliente</dt>
            <dd class="fw-semibold text-foreground mb-0 text-break"><%= @tab.guest_identifier %></dd>
          </div>
          <div class="col-12 col-sm-6">
            <dt class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing: 0.05em;">Aberta por</dt>
            <dd class="fw-semibold text-foreground mb-0 text-break"><%= @tab.opened_by.name %></dd>
          </div>
          <div class="col-12 col-sm-6">
            <dt class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing: 0.05em;">Abertura</dt>
            <dd class="fw-semibold text-foreground mb-0 text-break"><%= l(@tab.created_at, format: :long) %></dd>
          </div>
          <% if @tab.closed_at %>
            <div class="col-12 col-sm-6">
              <dt class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing: 0.05em;">Fechamento</dt>
              <dd class="fw-semibold text-foreground mb-0 text-break"><%= l(@tab.closed_at, format: :long) %></dd>
            </div>
            <div class="col-12 col-sm-6">
              <dt class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing: 0.05em;">Fechada por</dt>
              <dd class="fw-semibold text-foreground mb-0 text-break"><%= @tab.closed_by&.name || "—" %></dd>
            </div>
          <% end %>
          <% if @tab.paid_at %>
            <div class="col-12 col-sm-6">
              <dt class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing: 0.05em;">Pagamento</dt>
              <dd class="fw-semibold text-foreground mb-0 text-break"><%= l(@tab.paid_at, format: :long) %></dd>
            </div>
          <% end %>
          <% if @tab.notes.present? %>
            <div class="col-12">
              <dt class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing: 0.05em;">Observações</dt>
              <dd class="mb-0 text-break">
                <div class="p-3 rounded border" style="background-color: var(--color-bg); border-color: var(--color-border) !important;">
                  <%= simple_format @tab.notes, class: "mb-0" %>
                </div>
              </dd>
            </div>
          <% end %>
        </dl>
      </div>
    </article>
  </div>

  <div class="col-lg-6">
    <article class="card h-100">
      <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-calculator text-primary"></i>
        <h2 class="h5 mb-0">Totais</h2>
      </div>
      <div class="card-body">
        <dl class="mb-0">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <dt class="text-muted small fw-normal mb-0">Subtotal</dt>
            <dd class="fw-semibold text-foreground mb-0"><%= number_to_currency(@tab.subtotal) %></dd>
          </div>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <dt class="text-muted small fw-normal mb-0">Desconto</dt>
            <dd class="fw-semibold text-foreground mb-0 d-flex align-items-center gap-2">
              <%= number_to_currency(@tab.discount) %>
              <% if @tab.open? %>
                <%= link_to "#", class: "btn btn-tertiary btn-xs d-inline-flex align-items-center gap-1", data: { bs_toggle: "modal", bs_target: "#discountModal" } do %>
                  <i class="bi bi-pencil"></i>
                  <span><%= @tab.discount.positive? ? "Alterar" : "Aplicar" %></span>
                <% end %>
              <% end %>
            </dd>
          </div>
          <div class="d-flex justify-content-between align-items-center pt-3 mt-1 border-top" style="border-color: var(--color-border) !important;">
            <dt class="fw-semibold mb-0">Total</dt>
            <dd class="fw-bold text-primary mb-0" style="font-size: 1.35rem;"><%= number_to_currency(@tab.total) %></dd>
          </div>
        </dl>
      </div>
    </article>
  </div>
</div>

<article class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-list-ul text-primary"></i>
      <h2 class="h5 mb-0">Itens da Comanda</h2>
    </div>
    <span class="badge-custom <%= @tab.active_items.any? ? 'badge-success' : 'badge-muted' %>">
      <i class="bi bi-cart-check me-1" aria-hidden="true"></i><%= @tab.active_items.count %> item(ns) ativo(s)
    </span>
  </div>
  <div class="card-body p-0">
    <% if @tab.tab_items.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead style="background-color: var(--color-bg); border-bottom: 2px solid var(--color-border);">
            <tr class="text-muted small text-uppercase" style="letter-spacing: 0.05em;">
              <th class="border-0 ps-3 py-3 fw-semibold">Produto</th>
              <th class="border-0 py-3 fw-semibold text-center">Qtd</th>
              <th class="border-0 py-3 fw-semibold text-end">Unit.</th>
              <th class="border-0 py-3 fw-semibold text-end">Total</th>
              <th class="border-0 py-3 fw-semibold text-center">Status</th>
              <th class="border-0 py-3 fw-semibold">Lançado por</th>
              <th class="border-0 py-3 fw-semibold text-center">Hora</th>
              <th class="border-0 pe-3 py-3 fw-semibold text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @tab.tab_items.ordered.each do |item| %>
              <tr class="align-middle <%= 'text-muted' if item.voided? || item.transferred? %>" style="border-bottom: 1px solid var(--color-border);">
                <td class="ps-3">
                  <div class="fw-medium text-foreground"><%= item.product.name %></div>
                  <% if item.notes.present? %>
                    <div class="text-muted small"><%= item.notes %></div>
                  <% end %>
                </td>
                <td class="text-center"><%= item.quantity %></td>
                <td class="text-end"><%= number_to_currency(item.unit_price) %></td>
                <td class="text-end fw-semibold"><%= number_to_currency(item.total_price) %></td>
                <td class="text-center"><%= badge_for_item_status(item.status) %></td>
                <td><%= item.added_by.name %></td>
                <td class="text-center text-nowrap"><%= l(item.created_at, format: :time) %></td>
                <td class="pe-3 text-end">
                  <% if item.active? && @tab.open? %>
                    <div class="d-inline-flex gap-1">
                      <%= link_to "#", class: "btn btn-tertiary btn-xs", data: { bs_toggle: "modal", bs_target: "#quantityModal#{item.id}" } do %>
                        <i class="bi bi-pencil"></i>
                      <% end %>
                      <%= button_to void_room_tab_tab_item_path(@tab.room, @tab, item), method: :patch, class: "btn btn-tertiary btn-xs text-danger", form: { data: { turbo_confirm: "Estornar item \"#{item.product.name}\"?" } } do %>
                        <i class="bi bi-x-circle"></i>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5">
        <div class="icon-wrapper mx-auto mb-3" style="background-color: #F1F5F9; color: var(--color-muted);">
          <i class="bi bi-receipt-cutoff"></i>
        </div>
        <p class="text-muted mb-0">Nenhum item lançado nesta comanda.</p>
        <% if @tab.open? %>
          <%= link_to "#", class: "btn btn-primary mt-3 d-inline-flex align-items-center gap-2", data: { bs_toggle: "modal", bs_target: "#addItemModal" } do %>
            <i class="bi bi-plus-lg"></i>
            <span>Adicionar primeiro item</span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</article>

<!-- ===================== Modais ===================== -->

<!-- Add Item Modal -->
<div class="modal fade" id="addItemModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Adicionar Item</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <%= form_with url: room_tab_tab_items_path(@tab.room, @tab), local: true do |f| %>
        <div class="modal-body">
          <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
              <%= f.label :product_id, "Produto", class: "form-label" %>
              <%= f.collection_select :product_id, Product.active.ordered, :id, :name, { prompt: "Selecione..." }, { class: "form-select" } %>
            </div>
            <div class="col-6 col-md-3">
              <%= f.label :quantity, "Quantidade", class: "form-label" %>
              <%= f.number_field :quantity, value: 1, min: 1, class: "form-control" %>
            </div>
            <div class="col-6 col-md-3">
              <%= f.label :unit_price, "Preço Unit.", class: "form-label" %>
              <%= f.number_field :unit_price, step: "0.01", min: "0", class: "form-control", placeholder: "Padrão" %>
              <div class="form-text">Opcional</div>
            </div>
          </div>
          <div class="mb-0">
            <%= f.label :notes, "Observações", class: "form-label" %>
            <%= f.text_field :notes, class: "form-control", placeholder: "Ex: Sem gelo, bem gelado" %>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-tertiary" data-bs-dismiss="modal">Cancelar</button>
          <%= f.submit "Adicionar", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Discount Modal -->
<div class="modal fade" id="discountModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Aplicar Desconto</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <%= form_with url: apply_discount_room_tab_path(@tab.room, @tab), method: :patch, local: true do |f| %>
        <div class="modal-body">
          <% role = current_user.roles.first&.name || "attendant" %>
          <div class="row g-3">
            <div class="col-12 col-sm-6">
              <%= f.label :percent, "Desconto (%)", class: "form-label" %>
              <%= f.number_field :percent, step: "0.01", min: "0", max: DiscountLimit.max_percent_for(role), class: "form-control", value: 0 %>
              <div class="form-text">Limite: <%= DiscountLimit.max_percent_for(role) %>%</div>
            </div>
            <div class="col-12 col-sm-6">
              <%= f.label :absolute, "Desconto (R$)", class: "form-label" %>
              <%= f.number_field :absolute, step: "0.01", min: "0", max: DiscountLimit.max_absolute_for(role), class: "form-control", value: 0 %>
              <div class="form-text">Limite: <%= number_to_currency(DiscountLimit.max_absolute_for(role)) %></div>
            </div>
          </div>
          <p class="form-text mb-0 mt-3">Preencha apenas um dos campos acima. Se houver desconto vigente, o novo valor o substituirá.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-tertiary" data-bs-dismiss="modal">Cancelar</button>
          <%= f.submit "Aplicar Desconto", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Transfer Modal -->
<div class="modal fade" id="transferModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Transferir Comanda</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <%= form_with url: transfer_room_tab_path(@tab.room, @tab), method: :patch, local: true do |f| %>
        <div class="modal-body">
          <div class="mb-3">
            <%= f.label :target_room_id, "Quarto de destino", class: "form-label" %>
            <%= f.collection_select :target_room_id, Room.where.not(id: @tab.room_id).where(status: [:available, :occupied]).order(:number), :id, :number, { prompt: "Selecione..." }, { class: "form-select", required: true } %>
          </div>
          <div class="mb-3">
            <%= f.label :target_stay_id, "Estadia (opcional)", class: "form-label" %>
            <%= f.collection_select :target_stay_id, Stay.active_stays.where(room_id: Room.where.not(id: @tab.room_id).where(status: [:available, :occupied]).pluck(:id)), :id, :id, { prompt: "Nenhuma (criar passante)" }, { class: "form-select" } %>
          </div>
          <div class="mb-0">
            <%= f.label :notes, "Observações", class: "form-label" %>
            <%= f.text_field :notes, class: "form-control", placeholder: "Ex: Cliente trocou de quarto" %>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-tertiary" data-bs-dismiss="modal">Cancelar</button>
          <%= f.submit "Transferir", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Cancel Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Cancelar Comanda</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <%= form_with url: cancel_room_tab_path(@tab.room, @tab), method: :patch, local: true do |f| %>
        <div class="modal-body">
          <div class="alert alert-warning d-flex gap-2">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div><strong>Atenção:</strong> esta ação estorna todos os itens da comanda e não pode ser desfeita.</div>
          </div>
          <div class="mb-0">
            <%= f.label :reason, "Motivo do cancelamento", class: "form-label" %>
            <%= f.text_area :reason, rows: 3, class: "form-control", required: true, placeholder: "Ex: Cliente desistiu, erro de lançamento..." %>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-tertiary" data-bs-dismiss="modal">Voltar</button>
          <%= f.submit "Confirmar Cancelamento", class: "btn btn-danger" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Quantity Modals (um por item ativo) -->
<% @tab.tab_items.active.ordered.each do |item| %>
  <div class="modal fade" id="quantityModal<%= item.id %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Alterar Quantidade</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <%= form_with url: update_quantity_room_tab_tab_item_path(@tab.room, @tab, item), method: :patch, local: true do |f| %>
          <div class="modal-body">
            <p class="text-muted small mb-3">
              <%= item.product.name %> — atual <%= item.quantity %> un.
            </p>
            <div class="mb-3">
              <%= f.label :quantity, "Nova quantidade", class: "form-label" %>
              <%= f.number_field :quantity, value: item.quantity, min: 1, class: "form-control" %>
            </div>
            <div class="mb-0">
              <%= f.label :reason, "Motivo", class: "form-label" %>
              <%= f.text_field :reason, class: "form-control", placeholder: "Ex: Cliente pediu mais uma" %>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-tertiary" data-bs-dismiss="modal">Cancelar</button>
            <%= f.submit "Salvar", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
