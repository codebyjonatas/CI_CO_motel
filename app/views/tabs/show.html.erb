<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1>Comanda ##{@tab.id}</h1>
      <p class="text-muted mb-0">
        Quarto <%= @tab.room.number %> •
        <%= @tab.walk_in? ? "Passante" : "Estadia ##{@tab.stay_id}" %> •
        <%= badge_for_tab_status(@tab.status) %>
      </p>
    </div>
    <div class="btn-group">
      <% if @tab.open? %>
        <%= link_to "Adicionar Item", "#add-item-modal", class: "btn btn-primary", data: { bs_toggle: "modal", bs_target: "#addItemModal" } %>
        <%= button_to close_room_tab_path(@tab.room, @tab), method: :patch, class: "btn btn-success", form: { data: { turbo_confirm: "Fechar comanda?" } } %>
        <% if policy(@tab).pay? %>
          <%= button_to pay_room_tab_path(@tab.room, @tab), method: :patch, class: "btn btn-dark", form: { data: { turbo_confirm: "Marcar como paga?" } } %>
        <% end %>
        <% if policy(@tab).cancel? %>
          <%= link_to "Cancelar", "#cancel-modal", class: "btn btn-danger", data: { bs_toggle: "modal", bs_target: "#cancelModal" } %>
        <% end %>
        <% if policy(@tab).transfer? %>
          <%= link_to "Transferir", "#transfer-modal", class: "btn btn-outline-secondary", data: { bs_toggle: "modal", bs_target: "#transferModal" } %>
        <% end %>
      <% elsif @tab.closed? %>
        <% if policy(@tab).pay? %>
          <%= button_to pay_room_tab_path(@tab.room, @tab), method: :patch, class: "btn btn-dark", form: { data: { turbo_confirm: "Confirmar pagamento?" } } %>
        <% end %>
      <% end %>
      <%= link_to room_tabs_path(@tab.room), class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left"></i> Voltar
      <% end %>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Informações</h5>
        </div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-sm-3">Cliente</dt>
            <dd class="col-sm-9"><%= @tab.guest_identifier %></dd>

            <dt class="col-sm-3">Aberta por</dt>
            <dd class="col-sm-9"><%= @tab.opened_by.name %></dd>

            <dt class="col-sm-3">Abertura</dt>
            <dd class="col-sm-9"><%= l(@tab.created_at, format: :long) %></dd>

            <% if @tab.closed_at %>
              <dt class="col-sm-3">Fechamento</dt>
              <dd class="col-sm-9"><%= l(@tab.closed_at, format: :long) %></dd>
              <dt class="col-sm-3">Fechada por</dt>
              <dd class="col-sm-9"><%= @tab.closed_by&.name %></dd>
            <% end %>

            <% if @tab.paid_at %>
              <dt class="col-sm-3">Pagamento</dt>
              <dd class="col-sm-9"><%= l(@tab.paid_at, format: :long) %></dd>
            <% end %>

            <% if @tab.notes.present? %>
              <dt class="col-sm-3">Observações</dt>
              <dd class="col-sm-9"><%= @tab.notes %></dd>
            <% end %>
          </dl>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Totais</h5>
        </div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-sm-4">Subtotal</dt>
            <dd class="col-sm-8"><%= number_to_currency(@tab.subtotal) %></dd>

            <dt class="col-sm-4">Desconto</dt>
            <dd class="col-sm-8">
              <%= number_to_currency(@tab.discount) %>
              <% if @tab.discount.positive? && @tab.open? %>
                <%= link_to "Alterar", "#discount-modal", class: "btn btn-sm btn-outline-secondary ms-2", data: { bs_toggle: "modal", bs_target: "#discountModal" } %>
              <% end %>
            </dd>

            <dt class="col-sm-4"><strong>Total</strong></dt>
            <dd class="col-sm-8"><strong><%= number_to_currency(@tab.total) %></strong></dd>
          </dl>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Itens da Comanda</h5>
      <span class="badge bg-<%= @tab.active_items.any? ? 'success' : 'secondary' %>">
        <%= @tab.active_items.count %> item(s) ativo(s)
      </span>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Produto</th>
              <th class="text-center">Qtd</th>
              <th class="text-end">Unit.</th>
              <th class="text-end">Total</th>
              <th class="text-center">Status</th>
              <th class="text-center">Lançado por</th>
              <th class="text-center">Hora</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @tab.tab_items.ordered.each do |item| %>
              <tr class="<%= 'table-secondary' if item.voided? || item.transferred? %>">
                <td>
                  <%= item.product.name %>
                  <% if item.notes.present? %>
                    <br><small class="text-muted"><%= item.notes %></small>
                  <% end %>
                </td>
                <td class="text-center"><%= item.quantity %></td>
                <td class="text-end"><%= number_to_currency(item.unit_price) %></td>
                <td class="text-end"><%= number_to_currency(item.total_price) %></td>
                <td class="text-center"><%= badge_for_item_status(item.status) %></td>
                <td class="text-center"><%= item.added_by.name %></td>
                <td class="text-center"><%= l(item.created_at, format: :time) %></td>
                <td>
                  <% if item.active? && @tab.open? %>
                    <%= button_to void_room_tab_tab_item_path(@tab.room, @tab, item), method: :patch, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Estornar item?" } } do %>
                      <i class="bi bi-x-circle"></i>
                    <% end %>
                    <%= link_to "#", class: "btn btn-sm btn-outline-secondary", data: { bs_toggle: "modal", bs_target: "#quantityModal#{item.id}" } do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                  <% end %>
                </td>
              </tr>

              <!-- Quantity Modal -->
              <div class="modal fade" id="quantityModal<%= item.id %>" tabindex="-1">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title">Alterar Quantidade</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <%= form_with url: update_quantity_room_tab_tab_item_path(@tab.room, @tab, item), method: :patch, local: true do |f| %>
                      <div class="modal-body">
                        <div class="mb-3">
                          <%= f.label :quantity, "Nova Quantidade", class: "form-label" %>
                          <%= f.number_field :quantity, value: item.quantity, min: 1, class: "form-control" %>
                        </div>
                        <div class="mb-3">
                          <%= f.label :reason, "Motivo", class: "form-label" %>
                          <%= f.text_field :reason, class: "form-control", placeholder: "Ex: Cliente pediu mais uma" %>
                        </div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <%= f.submit "Salvar", class: "btn btn-primary" %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Add Item Modal -->
  <div class="modal fade" id="addItemModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Adicionar Item</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <%= form_with url: room_tab_tab_items_path(@tab.room, @tab), local: true do |f| %>
          <div class="modal-body">
            <div class="row mb-3">
              <div class="col-md-6">
                <%= f.label :product_id, "Produto", class: "form-label" %>
                <%= f.collection_select :product_id, Product.active.ordered, :id, :name, { prompt: "Selecione...", include_blank: false }, { class: "form-select" } %>
              </div>
              <div class="col-md-3">
                <%= f.label :quantity, "Quantidade", class: "form-label" %>
                <%= f.number_field :quantity, value: 1, min: 1, class: "form-control" %>
              </div>
              <div class="col-md-3">
                <%= f.label :unit_price, "Preço Unit. (opcional)", class: "form-label" %>
                <%= f.number_field :unit_price, step: "0.01", min: "0", class: "form-control", placeholder: "Padrão do produto" %>
              </div>
            </div>
            <div class="mb-3">
              <%= f.label :notes, "Observações", class: "form-label" %>
              <%= f.text_field :notes, class: "form-control", placeholder: "Ex: Sem gelo, bem gelado" %>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <%= f.submit "Adicionar", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Discount Modal -->
  <div class="modal fade" id="discountModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Aplicar Desconto</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <%= form_with url: apply_discount_room_tab_path(@tab.room, @tab), method: :patch, local: true do |f| %>
          <div class="modal-body">
            <div class="mb-3">
              <%= f.label :percent, "Desconto (%)", class: "form-label" %>
              <%= f.number_field :percent, step: "0.01", min: "0", max: DiscountLimit.max_percent_for(current_user.roles.first&.name || 'attendant'), class: "form-control", value: 0 %>
              <div class="form-text">Limite: <%= DiscountLimit.max_percent_for(current_user.roles.first&.name || 'attendant') %>%</div>
            </div>
            <div class="mb-3">
              <%= f.label :absolute, "Desconto (R$)", class: "form-label" %>
              <%= f.number_field :absolute, step: "0.01", min: "0", max: DiscountLimit.max_absolute_for(current_user.roles.first&.name || 'attendant'), class: "form-control", value: 0 %>
              <div class="form-text">Limite: R$ <%= number_to_currency(DiscountLimit.max_absolute_for(current_user.roles.first&.name || 'attendant')) %></div>
            </div>
            <div class="form-text">Preencha apenas um dos campos acima.</div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <%= f.submit "Aplicar", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Cancel Modal -->
  <div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Cancelar Comanda</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <%= form_with url: cancel_room_tab_path(@tab.room, @tab), method: :patch, local: true do |f| %>
          <div class="modal-body">
            <div class="alert alert-warning">
              <strong>Atenção:</strong> Esta ação estornará todos os itens da comanda e não pode ser desfeita.
            </div>
            <div class="mb-3">
              <%= f.label :reason, "Motivo do cancelamento *", class: "form-label" %>
              <%= f.text_area :reason, rows: 3, class: "form-control", required: true, placeholder: "Ex: Cliente desistiu, erro de lançamento..." %>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <%= f.submit "Confirmar Cancelamento", class: "btn btn-danger" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Transfer Modal -->
  <div class="modal fade" id="transferModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Transferir Comanda</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <%= form_with url: transfer_room_tab_path(@tab.room, @tab), method: :patch, local: true do |f| %>
          <div class="modal-body">
            <div class="mb-3">
              <%= f.label :target_room_id, "Quarto Destino *", class: "form-label" %>
              <%= f.collection_select :target_room_id, Room.where.not(id: @tab.room_id).where(status: [:available, :occupied]).order(:number), :id, :number, { prompt: "Selecione..." }, { class: "form-select", required: true } %>
            </div>
            <div class="mb-3">
              <%= f.label :target_stay_id, "Estadia (opcional)", class: "form-label" %>
              <%= f.collection_select :target_stay_id, Stay.active_stays.where(room_id: Room.where.not(id: @tab.room_id).where(status: [:available, :occupied]).pluck(:id)), :id, :id, { prompt: "Nenhuma (criar passante)", include_blank: false }, { class: "form-select" } %>
            </div>
            <div class="mb-3">
              <%= f.label :notes, "Observações", class: "form-label" %>
              <%= f.text_field :notes, class: "form-control", placeholder: "Ex: Cliente trocou de quarto" %>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <%= f.submit "Transferir", class: "btn btn-warning" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>