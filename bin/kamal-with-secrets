#!/usr/bin/env bash
#
# bin/kamal-with-secrets — executa o Kamal com segredos de produção vindos do Bitwarden.
#
# Os segredos existem APENAS no ambiente do processo: nada é gravado em disco
# nem em histórico de shell. O `.kamal/secrets` lê essas variáveis.
#
# Requisitos: bw (Bitwarden CLI) e jq.
#
# Uso:
#   bin/kamal-with-secrets deploy
#   bin/kamal-with-secrets app logs -f
#   bin/kamal-with-secrets secrets pull   # inspeciona nomes, não valores
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

ITEM_MASTER_KEY="${ITEM_MASTER_KEY:-CI-CO Motel | Rails Master Key (prod)}"
ITEM_DB="${ITEM_DB:-CI-CO Motel | Database (prod)}"
ITEM_APP_CONFIG="${ITEM_APP_CONFIG:-CI-CO Motel | App Config (prod)}"
ITEM_SMTP="${ITEM_SMTP:-CI-CO Motel | SMTP}"
ITEM_REGISTRY="${ITEM_REGISTRY:-CI-CO Motel | Kamal Registry}"

die() { printf '\033[31m✖ %s\033[0m\n' "$*" >&2; exit 1; }
warn() { printf '\033[33m⚠ %s\033[0m\n' "$*" >&2; }

command -v bw >/dev/null 2>&1 || die "Bitwarden CLI (bw) não encontrado."
command -v jq >/dev/null 2>&1 || die "jq não encontrado."

if [[ -z "${BW_SESSION:-}" ]]; then
  if [[ -n "${BW_PASSWORD:-}" ]]; then
    BW_SESSION="$(bw unlock "$BW_PASSWORD" --raw)" || die "Falha ao desbloquear o vault."
  else
    BW_SESSION="$(bw unlock --raw)" || die "Falha ao desbloquear o vault."
  fi
fi
export BW_SESSION
bw sync --session "$BW_SESSION" >/dev/null 2>&1 || warn "Sync do vault falhou; usando cache local."

bw_item() { bw get item "$1" --session "$BW_SESSION" 2>/dev/null || true; }
bw_field() {
  local name="$1" json="$2"
  [[ -n "$json" ]] || return 0
  printf '%s' "$json" | jq -r --arg n "$name" \
    '([.fields[]? | select(.name == $n) | .value][0]) // empty'
}

# --- Master key -------------------------------------------------------------
RAILS_MASTER_KEY="$(bw get password "$ITEM_MASTER_KEY" --session "$BW_SESSION" 2>/dev/null || true)"
[[ -n "$RAILS_MASTER_KEY" ]] || die "RAILS_MASTER_KEY vazia (item: $ITEM_MASTER_KEY)"
[[ ${#RAILS_MASTER_KEY} -eq 32 ]] || die "RAILS_MASTER_KEY deveria ter 32 caracteres."
export RAILS_MASTER_KEY

# --- Banco ------------------------------------------------------------------
DB_JSON="$(bw_item "$ITEM_DB")"
DB_PASS="$(printf '%s' "$DB_JSON" | jq -r '.login.password // empty' 2>/dev/null || true)"
[[ -n "$DB_PASS" ]] || die "Senha do banco vazia (item: $ITEM_DB)"
export SYS_CHECK_IN_CHECK_OUT_DATABASE_PASSWORD="$DB_PASS"

# --- App config -------------------------------------------------------------
APP_JSON="$(bw_item "$ITEM_APP_CONFIG")"
for pair in \
  "APP_HOST:APP_HOST" \
  "SEED_ADMIN_PASSWORD:SEED_ADMIN_PASSWORD" \
  "SEED_ATTENDANT_PASSWORD:SEED_ATTENDANT_PASSWORD" \
  "DISCOUNT_LIMITS_ADMIN_MAX_PERCENT:DISCOUNT_LIMITS_ADMIN_MAX_PERCENT" \
  "DISCOUNT_LIMITS_ADMIN_MAX_ABSOLUTE:DISCOUNT_LIMITS_ADMIN_MAX_ABSOLUTE" \
  "DISCOUNT_LIMITS_ATTENDANT_MAX_PERCENT:DISCOUNT_LIMITS_ATTENDANT_MAX_PERCENT" \
  "DISCOUNT_LIMITS_ATTENDANT_MAX_ABSOLUTE:DISCOUNT_LIMITS_ATTENDANT_MAX_ABSOLUTE" \
  "ROOM_CLEANING_QUARANTINE_MINUTES:ROOM_CLEANING_QUARANTINE_MINUTES"; do
  field="${pair%%:*}"
  var="${pair##*:}"
  value="$(bw_field "$field" "$APP_JSON")"
  [[ -n "$value" ]] && export "$var=$value"
done

[[ -n "${APP_HOST:-}" ]] || die "APP_HOST não definido (item: $ITEM_APP_CONFIG)"

# --- SMTP (opcional) --------------------------------------------------------
SMTP_JSON="$(bw_item "$ITEM_SMTP")"
SMTP_USER="$(printf '%s' "$SMTP_JSON" | jq -r '.login.username // empty' 2>/dev/null || true)"
SMTP_PASS="$(printf '%s' "$SMTP_JSON" | jq -r '.login.password // empty' 2>/dev/null || true)"
SMTP_ADDRESS="$(bw_field address "$SMTP_JSON")"
SMTP_PORT="$(bw_field port "$SMTP_JSON")"
[[ -n "$SMTP_USER" ]] && export SMTP_USER_NAME="$SMTP_USER"
[[ -n "$SMTP_PASS" ]] && export SMTP_PASSWORD="$SMTP_PASS"
[[ -n "$SMTP_ADDRESS" ]] && export SMTP_ADDRESS="$SMTP_ADDRESS"
[[ -n "$SMTP_PORT" ]] && export SMTP_PORT="$SMTP_PORT"

# --- Registry (opcional) ----------------------------------------------------
REG_JSON="$(bw_item "$ITEM_REGISTRY")"
REG_USER="$(printf '%s' "$REG_JSON" | jq -r '.login.username // empty' 2>/dev/null || true)"
REG_PASS="$(printf '%s' "$REG_JSON" | jq -r '.login.password // empty' 2>/dev/null || true)"
[[ -n "$REG_USER" ]] && export KAMAL_REGISTRY_USERNAME="$REG_USER"
[[ -n "$REG_PASS" ]] && export KAMAL_REGISTRY_PASSWORD="$REG_PASS"

echo "Segredos carregados do Bitwarden (APP_HOST=$APP_HOST). Executando: kamal $*" >&2
cd "$ROOT"
exec bundle exec kamal "$@"
